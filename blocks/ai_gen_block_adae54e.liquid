{% doc %}
  @prompt
    Now I want another short sections which title is "Shop our brands"
    
    Then please have small columns and in every single one i just need an image that you can click and can redirect to another section of this website
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-brand-grid-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-brand-grid__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-brand-grid__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-brand-grid__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-brand-grid__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: {{ block.settings.item_background_color }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-brand-grid__item-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-brand-grid__link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .ai-brand-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
  }

  .ai-brand-grid__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
    padding: {{ block.settings.image_padding }}px;
  }

  .ai-brand-grid__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-brand-grid__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 989px) {
    .ai-brand-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-brand-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-brand-grid__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }
{% endstyle %}

<div class="ai-brand-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-brand-grid__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-brand-grid__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <ul class="ai-brand-grid__grid-{{ ai_gen_id }}">
      {% for i in (1..12) %}
        {% liquid
          assign image_key = 'brand_image_' | append: i
          assign link_key = 'brand_link_' | append: i
          assign brand_image = block.settings[image_key]
          assign brand_link = block.settings[link_key]
        %}

        {% if brand_image != blank or brand_link != blank %}
          <li class="ai-brand-grid__item-{{ ai_gen_id }}">
            {% if brand_link != blank %}
              <a href="{{ brand_link }}" class="ai-brand-grid__link-{{ ai_gen_id }}">
            {% else %}
              <div class="ai-brand-grid__link-{{ ai_gen_id }}">
            {% endif %}
              <div class="ai-brand-grid__image-wrapper-{{ ai_gen_id }}">
                {% if brand_image != blank %}
                  <img
                    src="{{ brand_image | image_url: width: 600 }}"
                    alt="{{ brand_image.alt | escape }}"
                    loading="lazy"
                    width="{{ brand_image.width }}"
                    height="{{ brand_image.height }}"
                    class="ai-brand-grid__image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-brand-grid__placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
            {% if brand_link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>

