<section class="cfs-faq-grid" aria-labelledby="faq-title-{{ section.id }}">
  <header class="cfs-faq-grid__header">
    <h1 id="faq-title-{{ section.id }}">Frequently asked questions</h1>
    <p>Choose a topic to explore questions about CFS, products and facility care.</p>
  </header>
  {% assign topics = 'Company and ordering|Products and equipment|Floor care|Floor finishes|Floor stripping|Services' | split: '|' %}
  {% assign icons = 'icon-truck.svg|icon-box.svg|icon-leaf.svg|icon-star.svg|icon-bottle.svg|icon-chat-bubble.svg' | split: '|' %}
  <div class="cfs-faq-grid__topics">
    {% for topic in topics %}
      {% assign icon = icons[forloop.index0] %}
      {% assign count = 0 %}
      {% capture entries %}
        {% for block in section.blocks %}
          {% if block.settings.topic == topic %}
            {% assign count = count | plus: 1 %}
            <details class="cfs-faq-question" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question | escape }}</summary>
              <div class="cfs-faq-answer">{{ block.settings.answer }}</div>
            </details>
          {% endif %}
        {% endfor %}
      {% endcapture %}
      {% if count > 0 %}
        <details class="cfs-faq-topic" id="faq-{{ section.id }}-{{ topic | handleize }}" data-topic="{{ topic | handleize }}">
          <summary class="cfs-faq-topic__toggle">
            <span class="cfs-faq-topic__icon" aria-hidden="true">{{ icon | inline_asset_content }}</span>
            <span class="cfs-faq-topic__label"><strong>{{ topic | escape }}</strong><small>{{ count }} {% if count == 1 %}question{% else %}questions{% endif %}</small></span>
          </summary>
          <div class="cfs-faq-topic__questions">{{ entries }}</div>
        </details>
      {% endif %}
    {% endfor %}
  </div>
</section>
<style>
  .cfs-faq-grid { max-width: 1440px; margin: auto; padding: clamp(20px,4vw,64px) clamp(16px,3vw,48px) 64px; color:#15343b }
  .cfs-faq-grid__header { padding:clamp(28px,4vw,60px); margin-bottom:24px; border-radius:16px; background:linear-gradient(110deg,#053b33,#087055); color:white }
  .cfs-faq-grid__header h1 { margin:0; font-size:clamp(30px,4vw,54px); line-height:1.1; font-weight:700; color:inherit }
  .cfs-faq-grid__header p { margin:12px 0 0; line-height:1.5 }
  .cfs-faq-grid__topics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; align-items:start }
  .cfs-faq-topic { --accent:#175c84; --tint:#e8f4fb; background:var(--tint); border:1px solid var(--accent); border-top-width:4px; border-radius:12px; scroll-margin-top:8rem }
  .cfs-faq-topic[data-topic="products-and-equipment"] { --accent:#155e57; --tint:#e6f5ef }
  .cfs-faq-topic[data-topic="floor-care"] { --accent:#536324; --tint:#f1f5de }
  .cfs-faq-topic[data-topic="floor-finishes"] { --accent:#714389; --tint:#f5edf9 }
  .cfs-faq-topic[data-topic="floor-stripping"] { --accent:#934a20; --tint:#fff1e6 }
  .cfs-faq-topic[data-topic="services"] { --accent:#943f5b; --tint:#fbeef2 }
  .cfs-faq-grid summary { cursor:pointer; list-style:none; word-break:normal; overflow-wrap:normal; hyphens:none }
  .cfs-faq-grid summary::-webkit-details-marker { display:none }
  .cfs-faq-grid summary:focus-visible { outline:3px solid var(--accent); outline-offset:2px }
  .cfs-faq-topic__toggle { display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:14px; padding:clamp(16px,2vw,26px); min-height:110px; color:var(--accent) }
  .cfs-faq-topic__icon { display:grid; place-items:center; width:42px; height:42px; border-radius:12px; background:white }
  .cfs-faq-topic__icon svg { width:24px; height:24px; fill:currentColor }
  .cfs-faq-topic__label strong { display:block; font-size:clamp(18px,1.5vw,23px); line-height:1.2; color:#18343b }
  .cfs-faq-topic__label small { display:block; margin-top:6px; font-size:14px }
  .cfs-faq-grid summary::after { content:""; display:block; width:9px; height:9px; border:solid var(--accent); border-width:0 2px 2px 0; transform:rotate(45deg); justify-self:end }
  .cfs-faq-grid details[open]>summary::after { transform:rotate(225deg) }
  .cfs-faq-topic__questions { background:white; border-radius:0 0 11px 11px; padding:0 18px }
  .cfs-faq-question { border-top:1px solid #dae4df }
  .cfs-faq-question summary { display:grid; grid-template-columns:1fr auto; align-items:center; gap:12px; padding:15px 2px; font-weight:650; line-height:1.4 }
  .cfs-faq-answer { padding:0 2px 14px; line-height:1.6 }
  .cfs-faq-answer p { margin:0 0 .7em }.cfs-faq-answer p:last-child { margin:0 }.cfs-faq-answer a { color:var(--accent); text-decoration:underline }
  @media(max-width:1050px){ .cfs-faq-grid__topics { grid-template-columns:repeat(2,minmax(0,1fr)) } }
  @media(max-width:680px){ .cfs-faq-grid__topics { grid-template-columns:1fr; gap:12px }.cfs-faq-topic__toggle { min-height:82px } }
</style>
{% schema %}
{
  "name": "CFS FAQ Center",
  "settings": [],
  "blocks": [{
    "type":"question","name":"Question","settings":[
      {"type":"select","id":"topic","label":"Topic","default":"Company and ordering","options":[{"value":"Company and ordering","label":"Company and ordering"},{"value":"Products and equipment","label":"Products and equipment"},{"value":"Floor care","label":"Floor care"},{"value":"Floor finishes","label":"Floor finishes"},{"value":"Floor stripping","label":"Floor stripping"},{"value":"Services","label":"Services"}]},
      {"type":"text","id":"question","label":"Question"},
      {"type":"richtext","id":"answer","label":"Answer"}
    ]
  }]
}
{% endschema %}
