{{ 'cfs2.css' | asset_url | stylesheet_tag }}
<section class="cfs2-section cfs2-why">
  <div class="cfs2-container cfs2-why-grid">
    <div class="cfs2-why-image">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(max-width: 600px) 100vw, 50vw', alt: section.settings.image.alt }}{% elsif section.settings.image_url != blank %}<img src="{{ section.settings.image_url | escape }}" alt="{{ '' | escape }}" loading="lazy">{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}</div>
    <div>
      <div class="cfs2-eyebrow" style="color:var(--cfs2-lime)">{{ 'cfs2.why.eyebrow' | t }}</div>
      <h2>{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.description | escape }}</p>
      <ul>{% for block in section.blocks %}<li {{ block.shopify_attributes }}>{{ block.settings.title | escape }}</li>{% endfor %}</ul>
      {% if section.settings.button_link != blank %}<a class="cfs2-button cfs2-button-lime" href="{{ section.settings.button_link }}">{{ 'cfs2.why.cta' | t }}</a>{% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"CFS 2.0 Why CFS",
  "settings":[
    {"type":"image_picker","id":"image","label":"Photo"},
    {"type":"url","id":"image_url","label":"Image URL (optional)"} ,
    {"type":"text","id":"heading","label":"Heading","default":"More Than a Supplier. Your Facility Partner."},
    {"type":"textarea","id":"description","label":"Description","default":"Since 1979, we have helped commercial and institutional teams find supplies and practical support to keep facilities running."},
    {"type":"url","id":"button_link","label":"About CFS link"}
  ],
  "blocks":[{"type":"reason","name":"Benefit","settings":[{"type":"text","id":"title","label":"Benefit title"}]}],
  "max_blocks":6,
  "presets":[{"name":"CFS 2.0 Why CFS"}]
}
{% endschema %}
