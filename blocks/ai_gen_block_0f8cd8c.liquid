{% doc %}
  @prompt
    I want a section with our catalog in the left. This will take around 1/3 of the screen and the other 2/3 have a slideshow
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-catalog-slideshow-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px;
  }

  .ai-catalog-{{ ai_gen_id }} {
    flex: 0 0 33.333%;
    background-color: {{ block.settings.catalog_bg_color }};
    padding: {{ block.settings.catalog_padding }}px;
    border-radius: {{ block.settings.catalog_border_radius }}px;
    overflow-y: auto;
    max-height: {{ block.settings.catalog_max_height }}px;
  }

  .ai-catalog-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.catalog_title_size }}px;
    color: {{ block.settings.catalog_text_color }};
    margin: 0 0 20px 0;
    font-weight: 700;
  }

  .ai-catalog-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-catalog-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    background-color: {{ block.settings.catalog_item_bg }};
    border-radius: {{ block.settings.catalog_item_radius }}px;
    transition: transform 0.2s ease;
  }

  .ai-catalog-item-{{ ai_gen_id }}:hover {
    transform: translateX(4px);
  }

  .ai-catalog-item-image-{{ ai_gen_id }} {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
  }

  .ai-catalog-item-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-catalog-item-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-catalog-item-placeholder-{{ ai_gen_id }} svg {
    width: 30px;
    height: 30px;
  }

  .ai-catalog-item-info-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-catalog-item-title-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.catalog_text_color }};
    margin: 0 0 4px 0;
  }

  .ai-catalog-item-price-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.catalog_text_color }};
    opacity: 0.8;
  }

  .ai-catalog-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: {{ block.settings.catalog_text_color }};
    opacity: 0.6;
    font-size: 14px;
  }

  .ai-slideshow-{{ ai_gen_id }} {
    flex: 0 0 66.666%;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.slideshow_border_radius }}px;
    background-color: #f4f4f4;
  }

  .ai-slideshow-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.slideshow_height }}px;
  }

  .ai-slideshow-track-{{ ai_gen_id }} {
    display: flex;
    height: 100%;
    transition: transform 0.5s ease;
  }

  .ai-slide-{{ ai_gen_id }} {
    min-width: 100%;
    height: 100%;
    position: relative;
  }

  .ai-slide-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-slide-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-slide-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-slide-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 24px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 8px;
    font-size: 14px;
    color: #666;
    text-align: center;
  }

  .ai-slide-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 40px;
    left: 40px;
    right: 40px;
    background-color: {{ block.settings.slide_content_bg }};
    padding: 24px;
    border-radius: 12px;
    color: {{ block.settings.slide_content_text }};
  }

  .ai-slide-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.slide_title_size }}px;
    font-weight: 700;
    margin: 0 0 8px 0;
  }

  .ai-slide-description-{{ ai_gen_id }} {
    font-size: 16px;
    margin: 0 0 16px 0;
    line-height: 1.5;
  }

  .ai-slide-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.slide_button_bg }};
    color: {{ block.settings.slide_button_text }};
    text-decoration: none;
    border-radius: 40px;
    font-weight: 600;
    transition: opacity 0.3s ease;
  }

  .ai-slide-button-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-slideshow-controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 10;
  }

  .ai-slideshow-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.5);
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
    padding: 0;
  }

  .ai-slideshow-dot-{{ ai_gen_id }}.active {
    background-color: rgba(255, 255, 255, 1);
  }

  .ai-slideshow-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: rgba(255, 255, 255, 0.9);
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
    z-index: 10;
  }

  .ai-slideshow-nav-{{ ai_gen_id }}:hover {
    background-color: rgba(255, 255, 255, 1);
  }

  .ai-slideshow-nav-{{ ai_gen_id }}.prev {
    left: 20px;
  }

  .ai-slideshow-nav-{{ ai_gen_id }}.next {
    right: 20px;
  }

  @media screen and (max-width: 989px) {
    .ai-catalog-slideshow-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-catalog-{{ ai_gen_id }},
    .ai-slideshow-{{ ai_gen_id }} {
      flex: 1 1 100%;
    }

    .ai-catalog-{{ ai_gen_id }} {
      max-height: 400px;
    }

    .ai-slide-content-{{ ai_gen_id }} {
      left: 20px;
      right: 20px;
      bottom: 20px;
      padding: 16px;
    }
  }
{% endstyle %}

<catalog-slideshow-{{ ai_gen_id }} class="ai-catalog-slideshow-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-catalog-{{ ai_gen_id }}">
    <h2 class="ai-catalog-title-{{ ai_gen_id }}">{{ block.settings.catalog_title }}</h2>
    
    {% if block.settings.catalog_products.count > 0 %}
      <ul class="ai-catalog-list-{{ ai_gen_id }}">
        {% for product in block.settings.catalog_products %}
          <li class="ai-catalog-item-{{ ai_gen_id }}">
            <div class="ai-catalog-item-image-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 120 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  width="120"
                  height="120"
                  loading="lazy"
                >
              {% else %}
                <div class="ai-catalog-item-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-catalog-item-info-{{ ai_gen_id }}">
              <h3 class="ai-catalog-item-title-{{ ai_gen_id }}">{{ product.title }}</h3>
              <div class="ai-catalog-item-price-{{ ai_gen_id }}">{{ product.price | money }}</div>
            </div>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <div class="ai-catalog-empty-{{ ai_gen_id }}">
        Next, add products to your catalog
      </div>
    {% endif %}
  </div>

  <div class="ai-slideshow-{{ ai_gen_id }}">
    <div class="ai-slideshow-wrapper-{{ ai_gen_id }}">
      <div class="ai-slideshow-track-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          {% liquid
            assign image_key = 'slide_' | append: i | append: '_image'
            assign title_key = 'slide_' | append: i | append: '_title'
            assign description_key = 'slide_' | append: i | append: '_description'
            assign button_text_key = 'slide_' | append: i | append: '_button_text'
            assign button_link_key = 'slide_' | append: i | append: '_button_link'
            
            assign slide_image = block.settings[image_key]
            assign slide_title = block.settings[title_key]
            assign slide_description = block.settings[description_key]
            assign slide_button_text = block.settings[button_text_key]
            assign slide_button_link = block.settings[button_link_key]
          %}
          
          <div class="ai-slide-{{ ai_gen_id }}" data-slide="{{ i }}">
            {% if slide_image %}
              <img
                src="{{ slide_image | image_url: width: 1600 }}"
                alt="{{ slide_image.alt | escape }}"
                class="ai-slide-image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ slide_image.width }}"
                height="{{ slide_image.height }}"
              >
            {% else %}
              <div class="ai-slide-placeholder-{{ ai_gen_id }}">
                {{ 'hero-apparel-1' | placeholder_svg_tag }}
                {% if i == 1 %}
                  <div class="ai-slide-empty-state-{{ ai_gen_id }}">
                    Next, add images to your slides
                  </div>
                {% endif %}
              </div>
            {% endif %}
            
            {% if slide_title != blank or slide_description != blank or slide_button_text != blank %}
              <div class="ai-slide-content-{{ ai_gen_id }}">
                {% if slide_title != blank %}
                  <h3 class="ai-slide-title-{{ ai_gen_id }}">{{ slide_title }}</h3>
                {% endif %}
                {% if slide_description != blank %}
                  <div class="ai-slide-description-{{ ai_gen_id }}">{{ slide_description }}</div>
                {% endif %}
                {% if slide_button_text != blank and slide_button_link != blank %}
                  <a href="{{ slide_button_link }}" class="ai-slide-button-{{ ai_gen_id }}">
                    {{ slide_button_text }}
                  </a>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      {% if block.settings.show_navigation %}
        <button class="ai-slideshow-nav-{{ ai_gen_id }} prev" aria-label="Previous slide">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button class="ai-slideshow-nav-{{ ai_gen_id }} next" aria-label="Next slide">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      {% endif %}

      {% if block.settings.show_dots %}
        <div class="ai-slideshow-controls-{{ ai_gen_id }}">
          {% for i in (1..3) %}
            <button
              class="ai-slideshow-dot-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
              data-slide="{{ i }}"
              aria-label="Go to slide {{ i }}"
            ></button>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</catalog-slideshow-{{ ai_gen_id }}>

<script>
  (function() {
    class CatalogSlideshow{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.totalSlides = 3;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-slideshow-track-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-slideshow-dot-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-slideshow-nav-{{ ai_gen_id }}.prev');
        this.nextButton = this.querySelector('.ai-slideshow-nav-{{ ai_gen_id }}.next');

        this.setupEventListeners();
        this.startAutoplay();
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.goToPrevSlide());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.goToNextSlide());
        }

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => this.goToSlide(index));
        });

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => this.startAutoplay());
      }

      goToSlide(index) {
        this.currentSlide = index;
        this.updateSlidePosition();
        this.updateDots();
      }

      goToNextSlide() {
        this.currentSlide = (this.currentSlide + 1) % this.totalSlides;
        this.updateSlidePosition();
        this.updateDots();
      }

      goToPrevSlide() {
        this.currentSlide = (this.currentSlide - 1 + this.totalSlides) % this.totalSlides;
        this.updateSlidePosition();
        this.updateDots();
      }

      updateSlidePosition() {
        const offset = -this.currentSlide * 100;
        this.track.style.transform = `translateX(${offset}%)`;
      }

      updateDots() {
        this.dots.forEach((dot, index) => {
          if (index === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      startAutoplay() {
        const autoplayEnabled = {{ block.settings.autoplay | json }};
        const autoplaySpeed = {{ block.settings.autoplay_speed | times: 1000 }};

        if (autoplayEnabled) {
          this.autoplayInterval = setInterval(() => {
            this.goToNextSlide();
          }, autoplaySpeed);
        }
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('catalog-slideshow-{{ ai_gen_id }}', CatalogSlideshow{{ ai_gen_id }});
  })();
</script>

