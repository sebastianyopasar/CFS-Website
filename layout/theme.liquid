<!-- INICIO B2B CHECKOUT CONNECTOR (ADAPTABLE) -->
{% assign is_b2b_user = false %}
{% if customer %}
  {% for tag in customer.tags %}
    {% assign tag_upper = tag | upcase %}
    {% if tag_upper contains 'B2B' or tag_upper contains 'DISC' or tag_upper contains 'DEV' or tag_upper contains 'WHOLESALE' %}
      {% assign is_b2b_user = true %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if is_b2b_user %}
<script>
  (function() {
    console.log("🟢 B2B Interceptor activo para: {{ customer.email }}");

    const customerEmail = "{{ customer.email }}";
    
    // ⚠️ REEMPLAZA ESTA URL CON TU DOMINIO ACTIVO DE NGROK
    const connectorUrl = "https://rover-scooter-mushroom.ngrok-free.dev/api/b2b/create-checkout"; 
    let isProcessingB2B = false;

    function runB2BCheckout(btnElement) {
      if (isProcessingB2B) return;
      isProcessingB2B = true;

      if (btnElement) {
        if (btnElement.tagName === 'INPUT') btnElement.value = "Applying B2B pricing... ⏳";
        else if (btnElement.innerText) btnElement.innerText = "Applying B2B pricing... ⏳";
        btnElement.disabled = true;
      }

      fetch('/cart.js?v=' + Date.now())
        .then(res => res.json())
        .then(cart => {
          if (!cart.items || cart.items.length === 0) {
            window.location.href = "/cart";
            return;
          }

          const items = cart.items.map(item => ({
            variant_id: item.variant_id || item.id,
            sku: item.sku || '',
            quantity: item.quantity
          }));

          return fetch(connectorUrl, {
            method: 'POST',
            headers: { 
              'Content-Type': 'application/json',
              'ngrok-skip-browser-warning': 'true'
            },
            body: JSON.stringify({
              customerEmail: customerEmail,
              cartItems: items
            })
          });
        })
        .then(res => res ? res.json() : null)
        .then(data => {
          if (data && data.checkoutUrl) {
            console.log("🚀 Redirecting to B2B Invoice:", data.checkoutUrl);
            fetch('/cart/clear.js', { method: 'POST' })
              .then(() => window.location.replace(data.checkoutUrl))
              .catch(() => window.location.replace(data.checkoutUrl));
          } else {
            alert("Aviso: " + (data.error || "No se pudo generar el checkout B2B."));
            window.location.href = "/checkout";
          }
        })
        .catch(err => {
          console.error("❌ Error en B2B Checkout:", err);
          alert("Error de conexión con el servidor B2B.");
          window.location.href = "/checkout";
        });
    }

    // Interceptar clics en botones de Checkout (Cart Drawer y Cart Page)
    window.addEventListener("click", function(e) {
      const btn = e.target.closest('#CartDrawer-Checkout, #checkout, button[name="checkout"], input[name="checkout"], .cart__checkout-button, a[href*="/checkout"]');
      if (btn) {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        console.log("⚡ Clic en Checkout capturado.");
        runB2BCheckout(btn);
      }
    }, true);

    // Interceptar envíos de formularios de checkout
    window.addEventListener("submit", function(e) {
      const form = e.target;
      const action = form.getAttribute('action') || '';
      if (action.includes('/checkout') || form.name === 'checkout' || form.id === 'CartDrawer-Form') {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        console.log("⚡ Formulario de Checkout capturado.");
        const submitBtn = form.querySelector('button, input[type="submit"]') || form;
        runB2BCheckout(submitBtn);
      }
    }, true);

  })();
</script>
{% endif %}
<!-- FIN B2B CHECKOUT CONNECTOR -->

  </body>
</html>