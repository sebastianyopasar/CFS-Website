{% doc %}
  @prompt
    I want two columns. The first one is a two vertical square and vertical setting that allows me to add images, have text when I hover and have proper links when click, the other 2/3 is a slideshow with links to jump into particular sections of the website. I want it so i can customize the size for every image and height and width of the section, also I just want 3 images in the slideshow with links, I would like to also be able to set the width of this section. Please also help me adding the border radius on the right column, When I have different screen formats this height and width  changes. Please make this fixed for a full width and a desktop version, but also for the cellphone version make the format different. Make the left column in vertical and the slideshow below it
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-layout-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-two-column-container-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    height: {{ block.settings.section_height }}px;
  }

  .ai-two-column-left-{{ ai_gen_id }} {
    flex: 0 0 33.333%;
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }

  .ai-two-column-right-{{ ai_gen_id }} {
    flex: 0 0 66.666%;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.slideshow_border_radius }}px;
    min-width: 0;
  }

  .ai-image-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    cursor: pointer;
    flex: 1;
    min-height: 0;
  }

  .ai-image-card-{{ ai_gen_id }}:first-child {
    height: {{ block.settings.image_1_height }}px;
    flex-shrink: 0;
  }

  .ai-image-card-{{ ai_gen_id }}:last-child {
    height: {{ block.settings.image_2_height }}px;
    flex-shrink: 0;
  }

  .ai-image-card-img-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-image-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-card-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-image-card-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .ai-image-card-{{ ai_gen_id }}:hover .ai-image-card-overlay-{{ ai_gen_id }} {
    opacity: {{ block.settings.overlay_opacity }};
  }

  .ai-image-card-text-{{ ai_gen_id }} {
    color: {{ block.settings.overlay_text_color }};
    font-size: {{ block.settings.overlay_text_size }}px;
    text-align: center;
    font-weight: 600;
  }

  .ai-slideshow-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-slideshow-track-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-slideshow-slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .ai-slideshow-slide-{{ ai_gen_id }}.active {
    opacity: 1;
    pointer-events: auto;
  }

  .ai-slideshow-slide-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .ai-slideshow-slide-img-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-slideshow-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-slideshow-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-slideshow-controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 10;
  }

  .ai-slideshow-dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.5;
    cursor: pointer;
    border: none;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-slideshow-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-two-column-container-{{ ai_gen_id }} {
      flex-direction: column;
      height: auto;
      width: 100%;
      gap: 20px;
    }

    .ai-two-column-left-{{ ai_gen_id }} {
      flex: 0 0 auto;
      width: 100%;
      flex-direction: row;
      gap: 15px;
    }

    .ai-two-column-right-{{ ai_gen_id }} {
      flex: 0 0 auto;
      width: 100%;
      height: {{ block.settings.mobile_slideshow_height }}px;
    }

    .ai-image-card-{{ ai_gen_id }} {
      flex: 1;
      height: {{ block.settings.mobile_image_height }}px;
    }

    .ai-image-card-{{ ai_gen_id }}:first-child,
    .ai-image-card-{{ ai_gen_id }}:last-child {
      height: {{ block.settings.mobile_image_height }}px;
    }
  }
{% endstyle %}

<two-column-layout-{{ ai_gen_id }} class="ai-two-column-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-two-column-container-{{ ai_gen_id }}">
    <div class="ai-two-column-left-{{ ai_gen_id }}">
      {% if block.settings.image_1_link != blank %}
        <a href="{{ block.settings.image_1_link }}" class="ai-image-card-{{ ai_gen_id }}">
      {% else %}
        <div class="ai-image-card-{{ ai_gen_id }}">
      {% endif %}
        {% if block.settings.image_1 %}
          <img
            src="{{ block.settings.image_1 | image_url: width: 800 }}"
            alt="{{ block.settings.image_1.alt | escape }}"
            class="ai-image-card-img-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.image_1.width }}"
            height="{{ block.settings.image_1.height }}"
          >
        {% else %}
          <div class="ai-image-card-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
        {% if block.settings.image_1_text != blank %}
          <div class="ai-image-card-overlay-{{ ai_gen_id }}">
            <div class="ai-image-card-text-{{ ai_gen_id }}">{{ block.settings.image_1_text }}</div>
          </div>
        {% endif %}
      {% if block.settings.image_1_link != blank %}
        </a>
      {% else %}
        </div>
      {% endif %}

      {% if block.settings.image_2_link != blank %}
        <a href="{{ block.settings.image_2_link }}" class="ai-image-card-{{ ai_gen_id }}">
      {% else %}
        <div class="ai-image-card-{{ ai_gen_id }}">
      {% endif %}
        {% if block.settings.image_2 %}
          <img
            src="{{ block.settings.image_2 | image_url: width: 800 }}"
            alt="{{ block.settings.image_2.alt | escape }}"
            class="ai-image-card-img-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.image_2.width }}"
            height="{{ block.settings.image_2.height }}"
          >
        {% else %}
          <div class="ai-image-card-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
        {% if block.settings.image_2_text != blank %}
          <div class="ai-image-card-overlay-{{ ai_gen_id }}">
            <div class="ai-image-card-text-{{ ai_gen_id }}">{{ block.settings.image_2_text }}</div>
          </div>
        {% endif %}
      {% if block.settings.image_2_link != blank %}
        </a>
      {% else %}
        </div>
      {% endif %}
    </div>

    <div class="ai-two-column-right-{{ ai_gen_id }}">
      <div class="ai-slideshow-{{ ai_gen_id }}">
        <div class="ai-slideshow-track-{{ ai_gen_id }}">
          {% for i in (1..3) %}
            {% assign slide_image_key = 'slide_' | append: i | append: '_image' %}
            {% assign slide_link_key = 'slide_' | append: i | append: '_link' %}
            {% assign slide_image = block.settings[slide_image_key] %}
            {% assign slide_link = block.settings[slide_link_key] %}

            <div class="ai-slideshow-slide-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}" data-slide="{{ i }}">
              {% if slide_link != blank %}
                <a href="{{ slide_link }}" class="ai-slideshow-slide-link-{{ ai_gen_id }}">
              {% else %}
                <div class="ai-slideshow-slide-link-{{ ai_gen_id }}">
              {% endif %}
                {% if slide_image %}
                  <img
                    src="{{ slide_image | image_url: width: 1600 }}"
                    alt="{{ slide_image.alt | escape }}"
                    class="ai-slideshow-slide-img-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ slide_image.width }}"
                    height="{{ slide_image.height }}"
                  >
                {% else %}
                  <div class="ai-slideshow-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              {% if slide_link != blank %}
                </a>
              {% else %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>

        <div class="ai-slideshow-controls-{{ ai_gen_id }}">
          {% for i in (1..3) %}
            <button
              class="ai-slideshow-dot-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
              data-slide="{{ i }}"
              aria-label="Go to slide {{ i }}"
            ></button>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</two-column-layout-{{ ai_gen_id }}>

<script>
  (function() {
    class TwoColumnLayout{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 1;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.ai-slideshow-slide-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-slideshow-dot-{{ ai_gen_id }}');
        this.autoplayEnabled = {{ block.settings.autoplay }};
        this.autoplaySpeed = {{ block.settings.autoplay_speed }} * 1000;

        this.setupEventListeners();
        
        if (this.autoplayEnabled) {
          this.startAutoplay();
        }
      }

      setupEventListeners() {
        this.dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            const slideNumber = parseInt(dot.getAttribute('data-slide'));
            this.goToSlide(slideNumber);
            
            if (this.autoplayEnabled) {
              this.resetAutoplay();
            }
          });
        });
      }

      goToSlide(slideNumber) {
        this.slides.forEach((slide) => {
          slide.classList.remove('active');
        });
        this.dots.forEach((dot) => {
          dot.classList.remove('active');
        });

        const targetSlide = this.querySelector(`.ai-slideshow-slide-{{ ai_gen_id }}[data-slide="${slideNumber}"]`);
        const targetDot = this.querySelector(`.ai-slideshow-dot-{{ ai_gen_id }}[data-slide="${slideNumber}"]`);

        if (targetSlide) {
          targetSlide.classList.add('active');
        }
        if (targetDot) {
          targetDot.classList.add('active');
        }

        this.currentSlide = slideNumber;
      }

      nextSlide() {
        let next = this.currentSlide + 1;
        if (next > 3) {
          next = 1;
        }
        this.goToSlide(next);
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, this.autoplaySpeed);
      }

      resetAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
        this.startAutoplay();
      }

      disconnectedCallback() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('two-column-layout-{{ ai_gen_id }}', TwoColumnLayout{{ ai_gen_id }});
  })();
</script>

