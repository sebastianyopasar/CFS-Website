{% if localization.available_languages.size > 1 %}
<details class="cfs-language"><summary aria-label="{{ 'cfs2.header.language' | t | escape }}"><i data-lang="{{ localization.language.iso_code }}"></i>{{ localization.language.iso_code | upcase }} ▾</summary>
{% assign form_id = 'CfsLanguage-' | append: section.id | append: mode %}
{% form 'localization', id: form_id %}{% for language in localization.available_languages %}
<button type="submit" name="locale_code" value="{{ language.iso_code }}" lang="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}aria-current="true"{% endif %}><i data-lang="{{ language.iso_code }}"></i>{{ language.endonym_name | capitalize | escape }}</button>
{% endfor %}{% endform %}</details>{% endif %}
