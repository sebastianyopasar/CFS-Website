<div id="pillar-modal" class="overlay-modal">
  <div class="modal-inner">
    <div class="close-btn" onclick="closePillar()">
      <span>&times;</span><label>Close</label>
    </div>
    <div id="modal-content-inject"></div>
    <div style="text-align:center; margin-top:60px;">
       <a href="/pages/contact" class="card-cta" style="width: auto; padding: 25px 80px;">Request a Demo</a>
    </div>
  </div>
</div>

<script>
const content = {
  p1: { 
    n: "1", 
    t: "Hygiene Dispensers", 
    img: "https://cdn.shopify.com/s/files/1/0728/6308/8863/files/Black_dispenser_white_towel_disp__202605131447.jpg?v=1778698104", // Update this link
    d: "Our process begins with an on-site visit to your facility to understand your current measures. We focus on providing the best products to ensure worker satisfaction and facility efficiency, rather than cutting edges on quality.", 
    f: ["Durability: Built for high-traffic and longevity.", "Low maintenance: Intuitive systems that reduce labor time.", "Waste reduction: Optimized dispensing to lower overhead costs."] 
  },
  p2: { 
    n: "2", 
    t: "Industrial Equipment", 
    img: "https://cdn.shopify.com/s/files/1/0728/6308/8863/files/Floor_scrubber_in_warehouse_202605131454.jpg?v=1778698501", // Update this link
    d: "We visit your facilities to evaluate your specific needs before suggesting purchase or rental options. By analyzing your current workflow, we ensure our dishwashers and scrubbers provide an overall improvement in efficiency.", 
    f: ["Heavy-duty engineering: Industrial-grade performance.", "Optimized efficiency: Faster turnaround times for cleaning cycles.", "Client satisfaction: Solutions built for heavy daily usage."] 
  },
  p3: { 
    n: "3", 
    t: "Chemical Dilution", 
    img: "https://cdn.shopify.com/s/files/1/0728/6308/8863/files/Worker_filling_spray_bottle_gree__202605131503.png?v=1778699207", // Update this link
    d: "We get to know your business to determine which dilution options fit best. By using concentrate products, we help you reduce waste and save money without sacrificing the effectiveness of your cleaning protocols.", 
    f: ["Accuracy: Precise dosing for consistent results.", "Safety: Minimized worker exposure to raw chemicals.", "Cost efficiency: Smart dilution for spray bottles and mop buckets."] 
  },
  p4: { 
    n: "4", 
    t: "Technical Training", 
    img: "https://cdn.shopify.com/s/files/1/0728/6308/8863/files/cq5dam.web.1280.1280_1.jpg?v=1778700014", // Update this link
    d: "Being client-focused means ensuring your team is successful. Our technicians provide on-site training and documentation specifically tailored to your facility's requirements and equipment setup.", 
    f: ["On-site training: Personalized sessions for your staff.", "Safety protocols: Ensuring operational excellence.", "Preferential service: Priority access to our technical expertise."] 
  }
};

function openPillar(id) {
  const item = content[id];
  
  // Logic for features: Bold and properly formatted text
  let feats = item.f.map(str => {
    const parts = str.split(':');
    return `<div>• <strong>${parts[0]}</strong>:${parts[1]}</div>`;
  }).join('');

  document.getElementById('modal-content-inject').innerHTML = `
    <div class="modal-header">
      <div class="modal-num-tag">${item.n}</div>
      <h2>${item.t}</h2>
    </div>
    <p>${item.d}</p>
    <div class="feat-list-expanded">
      <strong style="text-transform: uppercase;">FEATURES</strong>
      <div style="margin-top:25px;">${feats}</div>
    </div>
    <div class="modal-hero-wrap" style="margin-top:40px;">
      <img src="${item.img}" alt="${item.t}" style="width:100%; height:auto; border-radius:30px; display:block; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
    </div>
  `;
  
  document.getElementById('pillar-modal').classList.add('active');
  document.body.style.overflow = 'hidden';
}

function closePillar() {
  document.getElementById('pillar-modal').classList.remove('active');
  document.body.style.overflow = 'auto';
}
</script>

