{% doc %}
  @prompt
    Act as an expert web designer and create a new section for the Corporate Facility Supply website that showcases our three main proprietary brands: EcoStandard Solutions, Precision, and Contractor's Choice. The design should feature three distinct brand highlight blocks.Make it clickable to redirect to a different link. Each block must follow a two-column layout with descriptive text on the left and the brand logo on the right. Include an engaging headline and a brief text intro highlighting that we offer more than 120 proprietary products formulated for the high standards of our Southern Ontario clients.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-brand-showcase-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-brand-showcase__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-brand-showcase__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-brand-showcase__headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    color: {{ block.settings.headline_color }};
    margin: 0 0 {{ block.settings.headline_margin }}px;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-brand-showcase__intro-{{ ai_gen_id }} {
    font-size: {{ block.settings.intro_size }}px;
    color: {{ block.settings.intro_color }};
    margin: 0;
    line-height: 1.6;
    max-width: 800px;
    margin-left: {% if block.settings.text_alignment == 'center' %}auto{% else %}0{% endif %};
    margin-right: {% if block.settings.text_alignment == 'center' %}auto{% else %}0{% endif %};
  }

  .ai-brand-showcase__brands-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.brand_spacing }}px;
    margin-top: {{ block.settings.brands_top_margin }}px;
  }

  .ai-brand-showcase__brand-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    background-color: {{ block.settings.brand_bg_color }};
    border-radius: {{ block.settings.brand_border_radius }}px;
    padding: {{ block.settings.brand_padding }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: {{ block.settings.brand_border_width }}px solid {{ block.settings.brand_border_color }};
  }

  .ai-brand-showcase__brand-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(14, 27, 77, 0.12);
  }

  .ai-brand-showcase__brand-content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: {{ block.settings.content_gap }}px;
    align-items: center;
  }

  .ai-brand-showcase__text-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-brand-showcase__brand-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.brand_name_size }}px;
    color: {{ block.settings.brand_name_color }};
    margin: 0;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-brand-showcase__brand-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.brand_description_size }}px;
    color: {{ block.settings.brand_description_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-brand-showcase__logo-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.logo_width }}px;
    height: {{ block.settings.logo_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.logo_bg_color }};
    border-radius: {{ block.settings.logo_border_radius }}px;
    padding: {{ block.settings.logo_padding }}px;
  }

  .ai-brand-showcase__logo-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-brand-showcase__logo-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.logo_border_radius }}px;
  }

  .ai-brand-showcase__logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-brand-showcase__headline-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.headline_size }}px * 0.75);
    }

    .ai-brand-showcase__intro-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.intro_size }}px * 0.9);
    }

    .ai-brand-showcase__brand-content-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-brand-showcase__logo-wrapper-{{ ai_gen_id }} {
      width: 100%;
      max-width: 200px;
      margin: 0 auto;
    }

    .ai-brand-showcase__text-{{ ai_gen_id }} {
      text-align: center;
    }

    .ai-brand-showcase__brand-name-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.brand_name_size }}px * 0.9);
    }

    .ai-brand-showcase__brand-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.brand_description_size }}px * 0.9);
    }
  }
{% endstyle %}

<brand-showcase-{{ ai_gen_id }} class="ai-brand-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-brand-showcase__container-{{ ai_gen_id }}">
    <div class="ai-brand-showcase__header-{{ ai_gen_id }}">
      {% if block.settings.headline != blank %}
        <h2 class="ai-brand-showcase__headline-{{ ai_gen_id }}">
          {{ block.settings.headline }}
        </h2>
      {% endif %}
      
      {% if block.settings.intro_text != blank %}
        <div class="ai-brand-showcase__intro-{{ ai_gen_id }}">
          {{ block.settings.intro_text }}
        </div>
      {% endif %}
    </div>

    <div class="ai-brand-showcase__brands-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign brand_enabled_key = 'brand_' | append: i | append: '_enabled'
          assign brand_name_key = 'brand_' | append: i | append: '_name'
          assign brand_description_key = 'brand_' | append: i | append: '_description'
          assign brand_logo_key = 'brand_' | append: i | append: '_logo'
          assign brand_link_key = 'brand_' | append: i | append: '_link'

          assign brand_enabled = block.settings[brand_enabled_key]
          assign brand_name = block.settings[brand_name_key]
          assign brand_description = block.settings[brand_description_key]
          assign brand_logo = block.settings[brand_logo_key]
          assign brand_link = block.settings[brand_link_key]
        %}

        {% if brand_enabled %}
          <a 
            href="{{ brand_link }}" 
            class="ai-brand-showcase__brand-{{ ai_gen_id }}"
            {% if brand_link == blank %}aria-disabled="true" style="pointer-events: none;"{% endif %}
          >
            <div class="ai-brand-showcase__brand-content-{{ ai_gen_id }}">
              <div class="ai-brand-showcase__text-{{ ai_gen_id }}">
                {% if brand_name != blank %}
                  <h3 class="ai-brand-showcase__brand-name-{{ ai_gen_id }}">
                    {{ brand_name }}
                  </h3>
                {% endif %}
                
                {% if brand_description != blank %}
                  <div class="ai-brand-showcase__brand-description-{{ ai_gen_id }}">
                    {{ brand_description }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-brand-showcase__logo-wrapper-{{ ai_gen_id }}">
                {% if brand_logo %}
                  <img
                    src="{{ brand_logo | image_url: width: 400 }}"
                    alt="{{ brand_name | escape }}"
                    class="ai-brand-showcase__logo-{{ ai_gen_id }}"
                    loading="lazy"
                    width="400"
                    height="400"
                  >
                {% else %}
                  <div class="ai-brand-showcase__logo-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</brand-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class BrandShowcase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const brandLinks = this.querySelectorAll('.ai-brand-showcase__brand-{{ ai_gen_id }}');
        
        brandLinks.forEach((link) => {
          if (!link.getAttribute('href') || link.getAttribute('href') === '') {
            link.setAttribute('role', 'article');
            link.removeAttribute('href');
          }
        });
      }
    }

    customElements.define('brand-showcase-{{ ai_gen_id }}', BrandShowcase{{ ai_gen_id }});
  })();
</script>

