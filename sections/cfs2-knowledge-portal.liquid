<script src="{{ 'cfs2-cleaning-kollege-index.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cfs-guide-search.js' | asset_url }}" data-pages="{{ 'cfs-guide-pages.json' | asset_url }}" defer></script>

<section class="cfs-knowledge" data-cfs-knowledge-portal>
  <div class="cfs-knowledge__hero">
    <p class="cfs-knowledge__eyebrow">CFS CLEANING KOLLEGE</p>
    <h1>{{ section.settings.heading | escape }}</h1>
    <p>{{ section.settings.intro | escape }}</p>
  </div>

  <div class="cfs-knowledge__wrap">
    <div class="cfs-knowledge__tools">
      <article class="cfs-knowledge__tool">
        <span>01</span><h2>{{ 'cfs2.nav.calc' | t | escape_once }}</h2><p>{{ 'cfs2.calc_links.summary' | t | escape_once }}</p>
        <div class="cfs-calculator-links"><a href="{{ pages['product-calculator'].url }}">{{ 'cfs2.calc_links.product' | t | escape_once }}</a>
<a href="{{ pages['garbage-bag-size-calculator'].url }}">{{ 'cfs2.calc_links.bag' | t | escape_once }}</a></div>
      </article>
      <article class="cfs-knowledge__tool">
        <span>02</span><h2>Cleaning procedures</h2><p>Browse practical guides for floor care, carpet care, chemical dispensing, sanitation, and more.</p>
        <a href="#cfs-knowledge-guides">Browse guides <span aria-hidden="true">→</span></a>
      </article>
      <article class="cfs-knowledge__tool">
        <span>03</span><h2>Need a recommendation?</h2><p>Use Product Finder or contact the CFS team for product and facility-specific support.</p>
        <a href="/pages/contact">Talk to CFS <span aria-hidden="true">→</span></a>
      </article>
      <article class="cfs-knowledge__tool">
        <h2>Frequently asked questions</h2>
        <p>Find answers about orders, products, equipment service and floor care.</p>
        <a href="{{ pages['faq'].url | default: '/pages/faq' }}?view=pf-a20ad21e">Browse FAQs <span aria-hidden="true">→</span></a>
      </article>
    </div>

<div class="cfs-knowledge__library" id="cfs-knowledge-guides">
      <div><p class="cfs-knowledge__eyebrow">RESOURCE LIBRARY</p><h2>Find a Cleaning Kollege guide</h2><p>Search the current approved PDF library by title, topic or text inside a guide.</p></div>
      <label class="cfs-knowledge__search"><span class="visually-hidden">Search Cleaning Kollege guides</span><input type="search" data-cfs-guide-search placeholder="Try “carpet”, “floor finish”, or “dilution”" autocomplete="off"></label>
      <p class="cfs-knowledge__count" data-cfs-guide-count></p>
      <div class="cfs-knowledge__results" data-cfs-guide-results></div>
    </div>
  </div>
</section>

<style>
  .cfs-calculator-links {display:grid;gap:10px;justify-items:start}
  .cfs-knowledge{--cfs-forest:#052f27;--cfs-green:#08785d;--cfs-ink:#092a25;--cfs-lime:#b8df16;--cfs-sand:#f3f2ea;--cfs-line:#d7dfd8;background:var(--cfs-sand);color:var(--cfs-ink);font-family:var(--font-body-family),Arial,sans-serif;padding-bottom:80px}.cfs-knowledge__hero{isolation:isolate;overflow:hidden;position:relative;background:radial-gradient(circle at 84% 18%,#1a765c 0 2%,transparent 23%),radial-gradient(circle at 72% 110%,#0c9b75 0,transparent 35%),linear-gradient(118deg,#03251f 0%,#064b3b 58%,#08785d 100%);color:#fff;padding:94px max(24px,calc((100% - 1120px)/2)) 128px}.cfs-knowledge__hero:before,.cfs-knowledge__hero:after{content:"";position:absolute;z-index:-1;border:1px solid rgba(255,255,255,.16);border-radius:50%}.cfs-knowledge__hero:before{width:480px;height:480px;right:-110px;top:-210px;box-shadow:0 0 0 54px rgba(184,223,22,.07),0 0 0 109px rgba(255,255,255,.035)}.cfs-knowledge__hero:after{width:210px;height:210px;right:16%;bottom:-135px;background:rgba(184,223,22,.1)}.cfs-knowledge__hero>*{position:relative;z-index:1}.cfs-knowledge__eyebrow{font:800 11px/1 var(--font-body-family),Arial,sans-serif;letter-spacing:.16em;color:var(--cfs-lime);margin:0 0 18px}.cfs-knowledge h1,.cfs-knowledge h2{font-family:var(--font-body-family),Arial,sans-serif;font-weight:var(--font-body-weight-bold);letter-spacing:-.045em}.cfs-knowledge h1{max-width:800px;font-size:clamp(43px,6vw,76px);line-height:.96;margin:0 0 22px;color:#fff;text-wrap:balance}.cfs-knowledge__hero>p:not(.cfs-knowledge__eyebrow){max-width:610px;margin:0;color:#e5f1e9;font-size:18px;line-height:1.62;font-weight:500}.cfs-knowledge__wrap{box-sizing:border-box;max-width:1360px;margin:0 auto;padding:0 24px}.cfs-knowledge__tools{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:-62px;position:relative;z-index:2}.cfs-knowledge__tool{position:relative;overflow:hidden;background:linear-gradient(145deg,#fff 0%,#f8faf4 100%);border:1px solid rgba(9,42,37,.12);border-radius:4px;padding:30px 27px 27px;box-shadow:0 22px 44px rgba(3,37,31,.16);transition:transform .2s ease,box-shadow .2s ease}.cfs-knowledge__tool:before{content:"";position:absolute;width:94px;height:4px;top:0;left:0;background:var(--cfs-lime)}.cfs-knowledge__tool:hover{transform:translateY(-5px);box-shadow:0 28px 48px rgba(3,37,31,.22)}.cfs-knowledge__tool>span{display:inline-grid;place-items:center;width:34px;height:34px;border-radius:50%;background:#e7f2cb;color:#08684f;font:800 11px var(--font-body-family),Arial,sans-serif;letter-spacing:.04em}.cfs-knowledge__tool h2{font-size:25px;line-height:1.05;margin:22px 0 12px}.cfs-knowledge__tool p{min-height:78px;color:#4a5f56;margin:0 0 24px;line-height:1.6}.cfs-knowledge a{color:#057056;font:800 13px var(--font-body-family),Arial,sans-serif;letter-spacing:.02em;text-decoration:none}.cfs-knowledge a:hover{color:var(--cfs-ink);text-decoration:underline;text-decoration-color:var(--cfs-lime);text-decoration-thickness:3px;text-underline-offset:4px}.cfs-knowledge__library{position:relative;overflow:hidden;background:linear-gradient(130deg,#073a30,#075b49);border-radius:4px;margin-top:44px;padding:44px;box-shadow:0 20px 42px rgba(3,37,31,.14)}.cfs-knowledge__library:after{content:"";position:absolute;width:330px;height:330px;border:1px solid rgba(184,223,22,.24);border-radius:50%;right:-110px;top:-175px;box-shadow:0 0 0 42px rgba(184,223,22,.06)}.cfs-knowledge__library>*{position:relative;z-index:1}.cfs-knowledge__library h2{font-size:clamp(31px,4vw,44px);line-height:1;margin:0 0 12px;color:#fff}.cfs-knowledge__library>div>p:not(.cfs-knowledge__eyebrow){color:#d9ebe2;margin:0;max-width:620px;line-height:1.6}.cfs-knowledge__search{display:block;margin:29px 0 10px}.cfs-knowledge__search input{width:100%;box-sizing:border-box;border:2px solid transparent;border-radius:3px;padding:17px 19px;color:var(--cfs-ink);background:#fff;font:700 16px var(--font-body-family),Arial,sans-serif;box-shadow:0 10px 20px rgba(0,0,0,.12)}.cfs-knowledge__search input:focus{outline:3px solid var(--cfs-lime);outline-offset:3px;border-color:#fff}.cfs-knowledge__count{font-size:13px;color:#c9dfd4;font-weight:600}.cfs-knowledge__results{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.cfs-knowledge__guide{display:block;background:rgba(255,255,255,.98);border:1px solid transparent;border-radius:3px;padding:17px 18px;color:var(--cfs-ink)!important;line-height:1.35;transition:background .16s ease,transform .16s ease}.cfs-knowledge__guide:hover{background:var(--cfs-lime);color:#052f27!important;text-decoration:none;transform:translateX(4px)}.cfs-knowledge__guide small{display:block;color:#08785d;font:800 10px var(--font-body-family),Arial,sans-serif;letter-spacing:.13em;margin-bottom:7px}@media(max-width:760px){.cfs-knowledge__hero{padding:68px 24px 98px}.cfs-knowledge h1{font-size:45px}.cfs-knowledge__tools,.cfs-knowledge__results{grid-template-columns:1fr}.cfs-knowledge__tools{margin-top:-42px}.cfs-knowledge__tool p{min-height:0}.cfs-knowledge__library{margin-top:30px;padding:32px 20px}.cfs-knowledge__hero:before{right:-270px}.cfs-knowledge__hero:after{right:-70px}}
.cfs-knowledge__tools{grid-template-columns:repeat(4,minmax(0,1fr))}
  .cfs-knowledge__tool{display:flex;flex-direction:column;align-items:flex-start;padding-inline:clamp(16px,1.8vw,26px)}
  .cfs-knowledge__tool,.cfs-knowledge__tool :is(h2,p,a){word-break:normal;overflow-wrap:normal;-webkit-hyphens:none;hyphens:none;white-space:normal}
  .cfs-knowledge__tool h2{max-width:100%;text-wrap:balance;font-size:clamp(21px,2vw,25px)}.cfs-knowledge__tool p{min-height:0}.cfs-knowledge__tool>a,.cfs-knowledge__tool>.cfs-calculator-links{margin-top:auto}
  .cfs-knowledge__tool>span:first-child{display:none}
  @media(max-width:1200px){.cfs-knowledge__tools{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:600px){.cfs-knowledge__tools{grid-template-columns:1fr}}
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const escapeHtml = (value) => String(value || '').replace(/[&<>'"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[c]));
    const category = (title) => /floor|pad|finish|strip/i.test(title) ? 'FLOOR CARE' : /carpet|spot/i.test(title) ? 'CARPET CARE' : /dilut|chemical|dispenser/i.test(title) ? 'CHEMICAL MANAGEMENT' : 'CLEANING GUIDE';
    document.querySelectorAll('[data-cfs-knowledge-portal]').forEach((portal) => {
      const input = portal.querySelector('[data-cfs-guide-search]'); const results = portal.querySelector('[data-cfs-guide-results]'); const count = portal.querySelector('[data-cfs-guide-count]');
      const guides = window.CFS_CLEANING_KOLLEGE || [];
      let revision=0;
      const render = async () => {const current=++revision; const term = input.value.trim().toLowerCase(); const matched = term ? await window.CfsGuideSearch.search(term,guides.length) : guides; if(current!==revision)return; count.textContent = `${matched.length} approved guide${matched.length === 1 ? '' : 's'} available`; results.innerHTML = matched.map((guide) => `<a class="cfs-knowledge__guide" href="${escapeHtml(guide.url)}"><small>${category(guide.title)} · PDF</small>${escapeHtml(guide.title)}${guide.page ? " · p. "+guide.page : ""} <span aria-hidden="true">→</span></a>`).join('') || '<p>No guide matches that search yet.</p>'; };
      input.addEventListener('input', render); render();
    });
  });
</script>

{% schema %}
{
  "name": "CFS Knowledge Portal",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Knowledge for better facility care."},
    {"type":"textarea","id":"intro","label":"Intro","default":"Practical cleaning guidance, approved resources, and calculators that help your team make better purchasing and maintenance decisions."}
  ],
  "presets": [{"name":"CFS Knowledge Portal"}]
}
{% endschema %}
