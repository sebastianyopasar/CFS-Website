{{ 'cfs2.css' | asset_url | stylesheet_tag }}
<section class="cfs2-section cfs2-products">
 <div class="cfs2-container">
   {% assign catalog_url = section.settings.collection.url | default: routes.all_products_collection_url %}
   <div class="cfs2-section-heading">
     <h2>{{ 'cfs2.home_updates.best' | t }}</h2>
     <a class="cfs2-link" href="{{ catalog_url }}?sort_by=best-selling">{{ 'cfs2.products.all' | t }}</a>
   </div>
   <cfs-bestsellers data-url="{{ catalog_url | escape }}?sort_by=best-selling&amp;view=cfs-bestsellers"></cfs-bestsellers>
   <script src="{{ 'cfs-bestsellers.js' | asset_url }}" defer></script>
 </div>
</section>
{% schema %}
{
 "name":"CFS 2.0 Products",
 "settings":[
  {"type":"collection","id":"collection","label":"Collection of real products"}
 ],
 "presets":[{"name":"CFS 2.0 Products"}]
}
{% endschema %}
