{% doc %}
  @prompt
    Create a two button section. Allow each button to be customizable. Also please allow a short message to display right above those two buttons. Keep it as simple as possible. Allow those buttons to have text inside and clickable to redirect somewhere else. , Also please allow me to change the font for these buttons
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-button-block-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 40px 20px;
    text-align: center;
  }

  .ai-two-button-message-{{ ai_gen_id }} {
    margin: 0 0 20px;
    color: {{ block.settings.message_color }};
    font-size: {{ block.settings.message_size }}px;
  }

  .ai-two-button-container-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .ai-two-button-link-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    font-style: {{ block.settings.button_font.style }};
    transition: all 0.3s ease;
  }

  .ai-two-button-link-1-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_1_bg_color }};
    color: {{ block.settings.button_1_text_color }};
  }

  .ai-two-button-link-1-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_1_hover_bg_color }};
    color: {{ block.settings.button_1_hover_text_color }};
  }

  .ai-two-button-link-2-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_2_bg_color }};
    color: {{ block.settings.button_2_text_color }};
  }

  .ai-two-button-link-2-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_2_hover_bg_color }};
    color: {{ block.settings.button_2_hover_text_color }};
  }
{% endstyle %}

<div class="ai-two-button-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.message != blank %}
    <p class="ai-two-button-message-{{ ai_gen_id }}">{{ block.settings.message }}</p>
  {% endif %}

  <div class="ai-two-button-container-{{ ai_gen_id }}">
    {% if block.settings.button_1_text != blank %}
      <a
        href="{{ block.settings.button_1_link }}"
        class="ai-two-button-link-{{ ai_gen_id }} ai-two-button-link-1-{{ ai_gen_id }}"
      >
        {{ block.settings.button_1_text }}
      </a>
    {% endif %}

    {% if block.settings.button_2_text != blank %}
      <a
        href="{{ block.settings.button_2_link }}"
        class="ai-two-button-link-{{ ai_gen_id }} ai-two-button-link-2-{{ ai_gen_id }}"
      >
        {{ block.settings.button_2_text }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Two button block",
  "settings": [
    {
      "type": "header",
      "content": "Message"
    },
    {
      "type": "text",
      "id": "message",
      "label": "Message text",
      "default": "Choose an option below"
    },
    {
      "type": "color",
      "id": "message_color",
      "label": "Message color",
      "default": "#0e1b4d"
    },
    {
      "type": "range",
      "id": "message_size",
      "label": "Message size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Button 1"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Text",
      "default": "Button 1"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "button_1_bg_color",
      "label": "Background color",
      "default": "#0e1b4d"
    },
    {
      "type": "color",
      "id": "button_1_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_1_hover_bg_color",
      "label": "Hover background color",
      "default": "#4770db"
    },
    {
      "type": "color",
      "id": "button_1_hover_text_color",
      "label": "Hover text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Button 2"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Text",
      "default": "Button 2"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "button_2_bg_color",
      "label": "Background color",
      "default": "#4770db"
    },
    {
      "type": "color",
      "id": "button_2_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_2_hover_bg_color",
      "label": "Hover background color",
      "default": "#0e1b4d"
    },
    {
      "type": "color",
      "id": "button_2_hover_text_color",
      "label": "Hover text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "font_picker",
      "id": "button_font",
      "label": "Button font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button font size",
      "min": 12,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Two button block"
    }
  ]
}
{% endschema %}
