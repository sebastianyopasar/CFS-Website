{% doc %}
  @prompt
    Do an announcement bar where i can have text on the right with a link and other links on the left, I would like to change the font to Monserat
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  {{ block.settings.font_family | font_face }}

  .ai-announcement-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    font-weight: bold;
    font-style: {{ block.settings.font_family.style }};
  }

  .ai-announcement-bar-container-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    gap: 20px;
  }

  .ai-announcement-bar-left-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.link_spacing }}px;
    flex-wrap: wrap;
  }

  .ai-announcement-bar-right-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ai-announcement-bar-link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-size: {{ block.settings.font_size }}px;
    font-weight: bold;
    transition: opacity 0.3s ease;
  }

  .ai-announcement-bar-link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-announcement-bar-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size }}px;
    margin: 0;
  }

  .ai-announcement-bar-main-link-{{ ai_gen_id }} {
    color: {{ block.settings.main_link_color }};
    text-decoration: none;
    font-size: {{ block.settings.font_size }}px;
    font-weight: bold;
    transition: opacity 0.3s ease;
  }

  .ai-announcement-bar-main-link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 10px;
      text-align: center;
    }

    .ai-announcement-bar-left-{{ ai_gen_id }},
    .ai-announcement-bar-right-{{ ai_gen_id }} {
      justify-content: center;
    }
  }
{% endstyle %}

<announcement-bar-{{ ai_gen_id }} class="ai-announcement-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-announcement-bar-container-{{ ai_gen_id }}">
    <div class="ai-announcement-bar-left-{{ ai_gen_id }}">
      {% if block.settings.left_link_1_text != blank %}
        <a href="{{ block.settings.left_link_1_url }}" class="ai-announcement-bar-link-{{ ai_gen_id }}">
          {{ block.settings.left_link_1_text }}
        </a>
      {% endif %}

      {% if block.settings.left_link_2_text != blank %}
        <a href="{{ block.settings.left_link_2_url }}" class="ai-announcement-bar-link-{{ ai_gen_id }}">
          {{ block.settings.left_link_2_text }}
        </a>
      {% endif %}

      {% if block.settings.left_link_3_text != blank %}
        <a href="{{ block.settings.left_link_3_url }}" class="ai-announcement-bar-link-{{ ai_gen_id }}">
          {{ block.settings.left_link_3_text }}
        </a>
      {% endif %}
    </div>

    <div class="ai-announcement-bar-right-{{ ai_gen_id }}">
      {% if block.settings.right_text != blank %}
        <span class="ai-announcement-bar-text-{{ ai_gen_id }}">{{ block.settings.right_text }}</span>
      {% endif %}

      {% if block.settings.right_link_text != blank %}
        <a href="{{ block.settings.right_link_url }}" class="ai-announcement-bar-main-link-{{ ai_gen_id }}">
          {{ block.settings.right_link_text }}
        </a>
      {% endif %}
    </div>
  </div>
</announcement-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class AnnouncementBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('announcement-bar-{{ ai_gen_id }}', AnnouncementBar{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "header",
      "content": "Left side links"
    },
    {
      "type": "text",
      "id": "left_link_1_text",
      "label": "Link 1 text",
      "default": "Shop"
    },
    {
      "type": "url",
      "id": "left_link_1_url",
      "label": "Link 1 URL"
    },
    {
      "type": "text",
      "id": "left_link_2_text",
      "label": "Link 2 text",
      "default": "About"
    },
    {
      "type": "url",
      "id": "left_link_2_url",
      "label": "Link 2 URL"
    },
    {
      "type": "text",
      "id": "left_link_3_text",
      "label": "Link 3 text",
      "default": "Contact"
    },
    {
      "type": "url",
      "id": "left_link_3_url",
      "label": "Link 3 URL"
    },
    {
      "type": "range",
      "id": "link_spacing",
      "label": "Link spacing",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Right side content"
    },
    {
      "type": "text",
      "id": "right_text",
      "label": "Text",
      "default": "Free shipping on orders over $50"
    },
    {
      "type": "text",
      "id": "right_link_text",
      "label": "Link text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "right_link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "font_picker",
      "id": "font_family",
      "label": "Font",
      "default": "montserrat_n7"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#0e1b4d"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Left link color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "main_link_color",
      "label": "Right link color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 1000,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "default": 1600
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}