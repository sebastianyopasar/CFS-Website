{% doc %}
  @prompt
    Act as an expert web designer and create a brand partner and distributor section for the Corporate Facility Supply website, positioned directly below the "Why Choose Us" section. The design should feature a clean, elegant brand logo carousel or a sleek, minimalist logo grid displaying trusted vendor partnerships with industry-leading manufacturers such as Essity, Kruger, Tennant, Kärcher, Hawk, and CAA. Include a bold, welcoming headline and a brief subtext explaining that these premium brand relationships are essential to our operations, enabling us to deliver the highest level of quality and service to our clients throughout Southern Ontario.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-brand-partners-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-brand-partners-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-brand-partners-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-brand-partners-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.subtext_spacing }}px;
    line-height: 1.2;
  }

  .ai-brand-partners-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.subtext_color }};
    line-height: 1.6;
    max-width: 800px;
    margin: 0 auto;
  }

  .ai-brand-partners-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    align-items: center;
  }

  .ai-brand-partners-logo-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.logo_padding }}px;
    background-color: {{ block.settings.logo_background }};
    border-radius: {{ block.settings.logo_border_radius }}px;
    border: {{ block.settings.logo_border_width }}px solid {{ block.settings.logo_border_color }};
    transition: all 0.3s ease;
    min-height: {{ block.settings.logo_min_height }}px;
  }

  .ai-brand-partners-logo-wrapper-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-brand-partners-logo-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    max-width: {{ block.settings.logo_max_width }}px;
    object-fit: contain;
    filter: grayscale({{ block.settings.logo_grayscale }}%);
    opacity: {{ block.settings.logo_opacity }};
    transition: all 0.3s ease;
  }

  .ai-brand-partners-logo-wrapper-{{ ai_gen_id }}:hover .ai-brand-partners-logo-{{ ai_gen_id }} {
    filter: grayscale(0%);
    opacity: 1;
  }

  .ai-brand-partners-logo-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.logo_border_radius }}px;
  }

  .ai-brand-partners-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 989px) {
    .ai-brand-partners-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-brand-partners-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.85);
    }

    .ai-brand-partners-subtext-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtext_size }}px * 0.95);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-brand-partners-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-brand-partners-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 0 {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-brand-partners-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-brand-partners-subtext-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtext_size }}px * 0.9);
    }
  }
{% endstyle %}

<brand-partners-{{ ai_gen_id }} class="ai-brand-partners-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-brand-partners-container-{{ ai_gen_id }}">
    <div class="ai-brand-partners-header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-brand-partners-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subtext != blank %}
        <div class="ai-brand-partners-subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</div>
      {% endif %}
    </div>

    <div class="ai-brand-partners-grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign logo_key = 'logo_' | append: i
          assign logo = block.settings[logo_key]
        %}
        
        <div class="ai-brand-partners-logo-wrapper-{{ ai_gen_id }}">
          {% if logo != blank %}
            <img
              src="{{ logo | image_url: width: 400 }}"
              alt="{{ logo.alt | escape }}"
              loading="lazy"
              width="{{ logo.width }}"
              height="{{ logo.height }}"
              class="ai-brand-partners-logo-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-brand-partners-logo-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</brand-partners-{{ ai_gen_id }}>

<script>
  (function() {
    class BrandPartners{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const logos = this.querySelectorAll('.ai-brand-partners-logo-{{ ai_gen_id }}');
        logos.forEach((logo) => {
          if (!logo.alt || logo.alt.trim() === '') {
            logo.setAttribute('alt', 'Brand partner logo');
          }
        });
      }
    }

    customElements.define('brand-partners-{{ ai_gen_id }}', BrandPartners{{ ai_gen_id }});
  })();
</script>

