{
  "sections": {
    "custom_liquid_tJUeHm": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Resource Portal & Calculators</title>\n<style>\n  :root {\n    --dark-blue: #101b4d;\n    --light-blue: #4a72d5;\n    --text-dark: #333;\n    --text-muted: #666;\n    --bg-light: #f8f9fa;\n    --border-color: #eaeaea;\n  }\n\n  body {\n    font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n    color: var(--text-dark);\n    line-height: 1.6;\n    margin: 0;\n    padding: 40px 20px;\n    background-color: #ffffff;\n  }\n\n  .portal-wrapper {\n    max-width: 1200px;\n    margin: 0 auto;\n  }\n\n  /* --- Top Action Header Styling --- */\n  .action-header {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n    margin-bottom: 60px;\n  }\n\n  .action-header h2 {\n    font-size: 32px;\n    font-weight: 400;\n    color: var(--dark-blue);\n    margin-bottom: 24px;\n  }\n\n  .button-group {\n    display: flex;\n    justify-content: center;\n    gap: 15px;\n    flex-wrap: wrap;\n  }\n\n  .btn {\n    padding: 14px 32px;\n    border-radius: 50px; /* Pill shape */\n    text-decoration: none;\n    font-weight: 500;\n    font-size: 16px;\n    transition: opacity 0.2s ease, transform 0.1s ease;\n    cursor: pointer;\n    border: none;\n    display: inline-block;\n  }\n\n  .btn:hover {\n    opacity: 0.9;\n    transform: translateY(-1px);\n  }\n\n  .btn-dark {\n    background-color: var(--dark-blue);\n    color: white;\n  }\n\n  .btn-light {\n    background-color: var(--light-blue);\n    color: white;\n  }\n\n  /* --- Knowledge Base Grid (2x2 Layout) --- */\n  .section-title {\n    font-size: 28px;\n    font-weight: 600;\n    color: var(--dark-blue);\n    margin-bottom: 10px;\n    text-align: center;\n  }\n  \n  .section-subtitle {\n    text-align: center;\n    color: var(--text-muted);\n    margin-bottom: 40px;\n  }\n\n  .resource-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));\n    gap: 24px;\n    margin-bottom: 60px;\n  }\n\n  .resource-card {\n    border: 1px solid var(--border-color);\n    border-radius: 12px;\n    padding: 30px;\n    box-shadow: 0 4px 15px rgba(0,0,0,0.03);\n    background: #fff;\n    display: flex;\n    flex-direction: column;\n  }\n\n  .resource-card .icon {\n    font-size: 28px;\n    color: var(--light-blue);\n    margin-bottom: 15px;\n  }\n\n  .resource-card p {\n    font-size: 15px;\n    color: var(--text-muted);\n    margin-top: 0;\n    margin-bottom: 20px;\n  }\n\n  .resource-link {\n    display: block;\n    color: var(--light-blue);\n    text-decoration: none;\n    margin-bottom: 12px;\n    font-size: 15px;\n  }\n\n  .resource-link:hover {\n    text-decoration: underline;\n  }\n\n  /* --- Searchable Dropdown Styling --- */\n  .search-container {\n    margin-top: auto;\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n  }\n\n  .search-input {\n    width: 100%;\n    padding: 12px 15px;\n    border: 1px solid var(--border-color);\n    border-radius: 6px;\n    font-size: 15px;\n    box-sizing: border-box;\n    font-family: inherit;\n  }\n\n  .search-input:focus {\n    outline: none;\n    border-color: var(--light-blue);\n    box-shadow: 0 0 0 2px rgba(74, 114, 213, 0.2);\n  }\n\n  /* --- Calculator Summary Banner --- */\n  .calculator-banner {\n    background-color: var(--bg-light);\n    border: 1px solid var(--border-color);\n    border-radius: 12px;\n    padding: 50px 30px;\n    text-align: center;\n    max-width: 800px;\n    margin: 0 auto 60px auto;\n  }\n\n  .calculator-banner h2 {\n    color: var(--dark-blue);\n    margin-top: 0;\n    font-size: 26px;\n  }\n\n  .calculator-banner p {\n    color: var(--text-muted);\n    font-size: 16px;\n    margin-bottom: 30px;\n    max-width: 600px;\n    margin-left: auto;\n    margin-right: auto;\n  }\n\n  @media (max-width: 768px) {\n    .resource-grid { grid-template-columns: 1fr; }\n  }\n</style>\n</head>\n<body>\n\n<div class=\"portal-wrapper\">\n  \n  <!-- Centered Action Header -->\n  <div class=\"action-header\">\n    <h2>How Can We Help Your Facility Today?</h2>\n    <div class=\"button-group\">\n      <a href=\"tel:+18559643474\" class=\"btn btn-dark\">Call For Service</a>\n      <a href=\"tel:+18006613259\" class=\"btn btn-light\">Call to Order Products</a>\n      <a href=\"/pages/contractor-program\" class=\"btn btn-dark\">Create Service Request</a>\n    </div>\n  </div>\n\n  <!-- Knowledge Base Section -->\n  <div style=\"margin-bottom: 50px;\">\n    <h2 class=\"section-title\">Knowledge Base & Resource Portal</h2>\n    <p class=\"section-subtitle\">Access technical specifications, data sheets, and safety information</p>\n    \n    <div class=\"resource-grid\">\n      \n      <!-- Top Left: Technical Specs -->\n      <div class=\"resource-card\">\n        <h3><span class=\"icon\">📄</span> Technical Specs</h3>\n        <p>Download detailed machine specifications and technical documentation</p>\n        <div>\n          <a href=\"https://cdn.shopify.com/s/files/1/0728/6308/8863/files/Chlorine_Test_Papers_1_Page.pdf?v=1779808171\" class=\"resource-link\">→ How to Use Chlorine Test Strips</a>\n          <a href=\"https://cdn.shopify.com/s/files/1/0728/6308/8863/files/Warewash_service_requirements.pdf?v=1779808171\" class=\"resource-link\">→ Warewash Service Requirements</a>\n          <a href=\"https://cdn.shopify.com/s/files/1/0728/6308/8863/files/Glashwasher_Procedures.pdf?v=1779808172\" class=\"resource-link\">→ Glasswasher Procedures</a>\n          <a href=\"https://cdn.shopify.com/s/files/1/0728/6308/8863/files/Choose_the_right_floor_finish_compressed.pdf?v=1779808183\" class=\"resource-link\">→ Choose the right Floor Finish</a>\n        </div>\n      </div>\n      \n      <!-- Top Right: Cut Data Sheets (Searchable Dropdown) -->\n      <div class=\"resource-card\">\n        <div class=\"icon\">📊</div>\n        <p>Access cut data sheets for all our products</p>\n        \n        <div class=\"search-container\">\n          <!-- The 'list' attribute connects this input to the datalist below -->\n          <input type=\"text\" list=\"cut-sheets\" id=\"sheet-search\" class=\"search-input\" placeholder=\"Type to search or browse products...\">\n          \n          <datalist id=\"cut-sheets\">\n            <!-- LIQUID INTEGRATION NOTE: Use a Liquid loop here to pull from your Shopify files -->\n            <option value=\"Heavy Duty Degreaser 4L\">\n            <option value=\"Glass & Surface Cleaner 1L\">\n            <option value=\"Industrial Floor Finish\">\n            <option value=\"Chlorine Sanitizer 20L\">\n            <option value=\"Eco-Friendly Hand Soap\">\n          </datalist>\n          \n          <button onclick=\"accessDataSheet()\" class=\"btn btn-light\" style=\"width: 100%; border-radius: 6px;\">Open Data Sheet</button>\n        </div>\n      </div>\n\n      <!-- Bottom Left: Step-by-Step Guides -->\n      <div class=\"resource-card\">\n        <div class=\"icon\">📖</div>\n        <p>Browse product brochures and step-by-step how-to guides</p>\n        <div>\n          <a href=\"https://cdn.shopify.com/s/files/1/0728/6308/8863/files/Why_CFS.pdf?v=1779807616\" class=\"resource-link\">→ Why Corporate Facility Supply?</a>\n          <a href=\"https://cdn.shopify.com/s/files/1/0728/6308/8863/files/Get_Rid_Of_Pet_Stains_Odours.pdf?v=1779807617\" class=\"resource-link\">→ How To Get Rid of Pet Stains and Odours</a>\n          <a href=\"https://cdn.shopify.com/s/files/1/0728/6308/8863/files/How_to_prevent_product_waste.pdf?v=1779807617\" class=\"resource-link\">→ How to prevent product waste</a>\n          <a href=\"https://cdn.shopify.com/s/files/1/0728/6308/8863/files/Get_Rid_of_Mold.pdf?v=1779807616\" class=\"resource-link\">→ How to Get Rid of Mold</a>\n        </div>\n      </div>\n\n      <!-- Bottom Right: Safety & Compliance -->\n      <div class=\"resource-card\">\n        <div class=\"icon\">⚠️</div>\n        <p>View safety data sheets and compliance documentation</p>\n        <div style=\"margin-top: auto;\">\n          <a href=\"https://corporatefacilitysupply.com/pages/sds\" class=\"btn btn-dark\" style=\"display: inline-block;\">View SDS Library</a>\n        </div>\n      </div>\n\n    </div>\n  </div>\n\n  <!-- Calculator Summary Redirect Section -->\n  <div class=\"calculator-banner\">\n    <div style=\"font-size: 40px; margin-bottom: 15px;\">🧮</div>\n    <h2>Interactive Calculators</h2>\n    <p>Take the guesswork out of your ordering. Use our interactive tools to calculate the exact garbage bag sizes for your receptacles, or determine the ready-to-use yield of our concentrated products to understand your true cost-in-use.</p>\n    <a href=\"/pages/calculators\" class=\"btn btn-dark\">Go to Calculators</a>\n  </div>\n\n</div>\n\n<script>\n  // Data Sheet Access Logic\n  function accessDataSheet() {\n    const searchInput = document.getElementById('sheet-search').value;\n    if (!searchInput) {\n      alert(\"Please select or type a product name.\");\n      return;\n    }\n    \n    // In a live Shopify environment, you would use JavaScript to map the selected value \n    // to its corresponding URL, or append the value as a URL parameter to your search page.\n    alert(`Navigating to data sheet for: ${searchInput}`);\n  }\n</script>\n\n</body>\n</html>",
