{% doc %}
  @prompt
    Act as an expert web designer and create a new section for the Corporate Facility Supply website that showcases our three main proprietary brands: EcoStandard Solutions, Precision, and Contractor's Choice. The design should feature three distinct brand highlight blocks. Each block must follow a two-column layout with descriptive text on the left and the brand logo on the right. Include an engaging headline and a brief text intro highlighting that we offer more than 120 proprietary products formulated for the high standards of our Southern Ontario clients.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-brand-showcase-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-brand-showcase__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-brand-showcase__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-brand-showcase__headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    color: {{ block.settings.headline_color }};
    margin: 0 0 {{ block.settings.headline_bottom_spacing }}px;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-brand-showcase__intro-{{ ai_gen_id }} {
    font-size: {{ block.settings.intro_size }}px;
    color: {{ block.settings.intro_color }};
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .ai-brand-showcase__brands-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.brand_spacing }}px;
    margin-top: {{ block.settings.brands_top_spacing }}px;
  }

  .ai-brand-showcase__brand-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.brand_column_gap }}px;
    align-items: center;
    padding: {{ block.settings.brand_padding }}px;
    background-color: {{ block.settings.brand_background }};
    border-radius: {{ block.settings.brand_border_radius }}px;
    border: {{ block.settings.brand_border_width }}px solid {{ block.settings.brand_border_color }};
  }

  .ai-brand-showcase__brand-text-{{ ai_gen_id }} {
    padding-right: 20px;
  }

  .ai-brand-showcase__brand-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.brand_name_size }}px;
    color: {{ block.settings.brand_name_color }};
    margin: 0 0 {{ block.settings.brand_name_spacing }}px;
    font-weight: 700;
    line-height: 1.3;
  }

  .ai-brand-showcase__brand-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.brand_description_size }}px;
    color: {{ block.settings.brand_description_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-brand-showcase__brand-logo-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .ai-brand-showcase__brand-logo-{{ ai_gen_id }} img {
    max-width: 100%;
    height: auto;
    max-height: {{ block.settings.logo_max_height }}px;
    object-fit: contain;
  }

  .ai-brand-showcase__logo-placeholder-{{ ai_gen_id }} {
    width: 100%;
    max-width: 300px;
    height: {{ block.settings.logo_max_height }}px;
    background-color: #f4f4f4;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-brand-showcase__logo-placeholder-{{ ai_gen_id }} svg {
    width: 80%;
    height: 80%;
    opacity: 0.3;
  }

  @media screen and (max-width: 989px) {
    .ai-brand-showcase__brand-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.brand_column_gap | times: 0.7 }}px;
    }

    .ai-brand-showcase__brand-text-{{ ai_gen_id }} {
      padding-right: 0;
      order: 2;
    }

    .ai-brand-showcase__brand-logo-{{ ai_gen_id }} {
      order: 1;
      padding: 10px;
    }

    .ai-brand-showcase__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.8 }}px;
    }

    .ai-brand-showcase__brand-name-{{ ai_gen_id }} {
      font-size: {{ block.settings.brand_name_size | times: 0.85 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-brand-showcase-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 0 {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-brand-showcase__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.65 }}px;
    }

    .ai-brand-showcase__intro-{{ ai_gen_id }} {
      font-size: {{ block.settings.intro_size | times: 0.9 }}px;
    }

    .ai-brand-showcase__brand-name-{{ ai_gen_id }} {
      font-size: {{ block.settings.brand_name_size | times: 0.75 }}px;
    }

    .ai-brand-showcase__brand-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.brand_description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<brand-showcase-{{ ai_gen_id }} class="ai-brand-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-brand-showcase__container-{{ ai_gen_id }}">
    <div class="ai-brand-showcase__header-{{ ai_gen_id }}">
      {% if block.settings.headline != blank %}
        <h2 class="ai-brand-showcase__headline-{{ ai_gen_id }}">
          {{ block.settings.headline }}
        </h2>
      {% endif %}
      
      {% if block.settings.intro_text != blank %}
        <div class="ai-brand-showcase__intro-{{ ai_gen_id }}">
          {{ block.settings.intro_text }}
        </div>
      {% endif %}
    </div>

    <div class="ai-brand-showcase__brands-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign brand_name_key = 'brand_' | append: i | append: '_name'
          assign brand_description_key = 'brand_' | append: i | append: '_description'
          assign brand_logo_key = 'brand_' | append: i | append: '_logo'
          
          assign brand_name = block.settings[brand_name_key]
          assign brand_description = block.settings[brand_description_key]
          assign brand_logo = block.settings[brand_logo_key]
        %}

        {% if brand_name != blank or brand_description != blank or brand_logo != blank %}
          <div class="ai-brand-showcase__brand-{{ ai_gen_id }}">
            <div class="ai-brand-showcase__brand-text-{{ ai_gen_id }}">
              {% if brand_name != blank %}
                <h3 class="ai-brand-showcase__brand-name-{{ ai_gen_id }}">
                  {{ brand_name }}
                </h3>
              {% endif %}
              
              {% if brand_description != blank %}
                <div class="ai-brand-showcase__brand-description-{{ ai_gen_id }}">
                  {{ brand_description }}
                </div>
              {% endif %}
            </div>

            <div class="ai-brand-showcase__brand-logo-{{ ai_gen_id }}">
              {% if brand_logo != blank %}
                <img
                  src="{{ brand_logo | image_url: width: 600 }}"
                  alt="{{ brand_name | escape }}"
                  loading="lazy"
                  width="{{ brand_logo.width }}"
                  height="{{ brand_logo.height }}"
                >
              {% else %}
                <div class="ai-brand-showcase__logo-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</brand-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class BrandShowcase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initAccessibility();
      }

      initAccessibility() {
        const brands = this.querySelectorAll('.ai-brand-showcase__brand-{{ ai_gen_id }}');
        brands.forEach((brand, index) => {
          brand.setAttribute('role', 'article');
          brand.setAttribute('aria-label', `Brand ${index + 1}`);
        });
      }
    }

    customElements.define('brand-showcase-{{ ai_gen_id }}', BrandShowcase{{ ai_gen_id }});
  })();
</script>

