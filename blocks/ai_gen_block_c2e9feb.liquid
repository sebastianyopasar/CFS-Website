{% doc %}
  @prompt
    Generate a modern, highly scannable corporate knowledge base and resource portal page for a commercial facility supply company. 
    
    Structure the layout cleanly using a visual grid or multi-column sections with clear icons and actionable buttons. Avoid generic walls of text or simple bulleted link lists. 
    
    Organize the layout into the following distinct operational segments:
    
    1. "Commercial Equipment & Machinery Hub": Focus on machine types like Industrial Dishwashers and Floor Scrubber Machines. Include dedicated sub-sections or cards for "Proper Machine Operation Guides" and "Preventative Maintenance Checklists".
    2. "Product Optimization & How-To Guides": Dedicated to educational training resources showing clients how to make the safest and most efficient use of our specialized chemical product lines.
    3. "Technical Downloads & Documentation": A section specifically for "Equipment Cut Data Sheets", printable dilution guides, and quick reference brochures.
    4. "Quick Resource Shortcuts": Include high-visibility short links directing users to our master Safety Data Sheets (SDS) repository and our automated Product Finder tool.
    
    Apply an authoritative, professional B2B tone. Use clean content cards with concise, descriptive headings, high-contrast action buttons for downloads, and a clear visual hierarchy that helps operational managers and cleaning crews find machine answers in seconds.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-knowledge-base-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-knowledge-base-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.section_spacing }}px;
  }

  .ai-knowledge-base-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-knowledge-base-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-knowledge-base-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: {{ block.settings.card_gap }}px;
    margin-bottom: {{ block.settings.section_spacing }}px;
  }

  .ai-knowledge-base-category-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_thickness }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-knowledge-base-category-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: 16px;
    border-bottom: 2px solid {{ block.settings.divider_color }};
  }

  .ai-knowledge-base-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_background }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    color: {{ block.settings.icon_color }};
  }

  .ai-knowledge-base-icon-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.6);
    height: calc({{ block.settings.icon_size }}px * 0.6);
  }

  .ai-knowledge-base-category-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_title_size }}px;
    color: {{ block.settings.category_title_color }};
    margin: 0;
    font-weight: 700;
    line-height: 1.3;
  }

  .ai-knowledge-base-subsection-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-knowledge-base-subsection-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.subsection_title_size }}px;
    color: {{ block.settings.subsection_title_color }};
    margin: 0;
    font-weight: 600;
    line-height: 1.4;
  }

  .ai-knowledge-base-link-list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-knowledge-base-link-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ai-knowledge-base-link-item-{{ ai_gen_id }}::before {
    content: '';
    width: 6px;
    height: 6px;
    background-color: {{ block.settings.bullet_color }};
    border-radius: 50%;
    flex-shrink: 0;
  }

  .ai-knowledge-base-link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-size: {{ block.settings.link_size }}px;
    line-height: 1.5;
    transition: color 0.2s ease;
  }

  .ai-knowledge-base-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
    text-decoration: underline;
  }

  .ai-knowledge-base-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_thickness }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .ai-knowledge-base-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-knowledge-base-button-{{ ai_gen_id }} svg {
    width: 16px;
    height: 16px;
  }

  .ai-knowledge-base-shortcuts-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-knowledge-base-shortcut-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.shortcut_background }};
    border: {{ block.settings.card_border_thickness }}px solid {{ block.settings.shortcut_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }

  .ai-knowledge-base-shortcut-icon-{{ ai_gen_id }} {
    width: {{ block.settings.shortcut_icon_size }}px;
    height: {{ block.settings.shortcut_icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.shortcut_icon_background }};
    border-radius: 50%;
    color: {{ block.settings.shortcut_icon_color }};
  }

  .ai-knowledge-base-shortcut-icon-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.shortcut_icon_size }}px * 0.5);
    height: calc({{ block.settings.shortcut_icon_size }}px * 0.5);
  }

  .ai-knowledge-base-shortcut-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.shortcut_title_size }}px;
    color: {{ block.settings.shortcut_title_color }};
    margin: 0;
    font-weight: 700;
  }

  .ai-knowledge-base-shortcut-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.shortcut_description_size }}px;
    color: {{ block.settings.shortcut_description_color }};
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-knowledge-base-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-knowledge-base-shortcuts-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-knowledge-base-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-knowledge-base-category-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.category_title_size }}px * 0.9);
    }
  }
{% endstyle %}

