{% doc %}
  @prompt
    Create a two-column layout section where the left column is a slideshow/carousel with multiple slides (each slide has an image, heading, subtext, and a call-to-action button with a configurable link), and the right column displays a single fixed static image with a configurable redirect link. The right column image should have adjustable sizing options (e.g., object-fit: cover/contain, custom height/width percentage) so the image can be made to fill or fit its container frame precisely. Both columns should be equal height and vertically aligned. All images, links, text, and sizing settings should be configurable through theme editor settings.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-slideshow-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-two-column-slideshow__container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.column_gap }}px;
    align-items: stretch;
    width: 100%;
  }

  .ai-two-column-slideshow__column-{{ ai_gen_id }} {
    flex: 1;
    min-height: {{ block.settings.min_height }}px;
    position: relative;
  }

  .ai-two-column-slideshow__carousel-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-two-column-slideshow__slides-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-two-column-slideshow__slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease, visibility 0.5s ease;
  }

  .ai-two-column-slideshow__slide-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .ai-two-column-slideshow__slide-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-two-column-slideshow__slide-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.slide_image_fit }};
  }

  .ai-two-column-slideshow__slide-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-two-column-slideshow__slide-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-two-column-slideshow__slide-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.content_padding }}px;
    background: {{ block.settings.content_overlay_color }};
    color: {{ block.settings.content_text_color }};
  }

  .ai-two-column-slideshow__slide-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 8px 0;
    font-weight: 600;
  }

  .ai-two-column-slideshow__slide-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    margin: 0 0 16px 0;
  }

  .ai-two-column-slideshow__slide-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    transition: background-color 0.3s ease;
  }

  .ai-two-column-slideshow__slide-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-two-column-slideshow__controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
    z-index: 2;
  }

  .ai-two-column-slideshow__control-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.control_button_color }};
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.control_icon_color }};
    transition: background-color 0.3s ease;
  }

  .ai-two-column-slideshow__control-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.control_button_hover_color }};
  }

  .ai-two-column-slideshow__control-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-two-column-slideshow__dots-{{ ai_gen_id }} {
    position: absolute;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 2;
  }

  .ai-two-column-slideshow__dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.5;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-two-column-slideshow__dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-two-column-slideshow__fixed-image-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-two-column-slideshow__fixed-image-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ai-two-column-slideshow__fixed-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
  }

  .ai-two-column-slideshow__fixed-img-{{ ai_gen_id }} {
    width: {{ block.settings.fixed_image_width }}%;
    height: {{ block.settings.fixed_image_height }}%;
    object-fit: {{ block.settings.fixed_image_fit }};
    display: block;
    margin: 0 auto;
  }

  .ai-two-column-slideshow__fixed-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-two-column-slideshow__fixed-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  @media screen and (max-width: 749px) {
    .ai-two-column-slideshow__container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 20px;
    }

    .ai-two-column-slideshow__column-{{ ai_gen_id }} {
      min-height: 400px;
    }
  }
{% endstyle %}

<two-column-slideshow-{{ ai_gen_id }}
  class="ai-two-column-slideshow-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-two-column-slideshow__container-{{ ai_gen_id }}">
    <div class="ai-two-column-slideshow__column-{{ ai_gen_id }}">
      <div class="ai-two-column-slideshow__carousel-{{ ai_gen_id }}">
        <div class="ai-two-column-slideshow__slides-{{ ai_gen_id }}">
          {% for i in (1..3) %}
            {% liquid
              assign slide_image_key = 'slide_' | append: i | append: '_image'
              assign slide_heading_key = 'slide_' | append: i | append: '_heading'
              assign slide_subtext_key = 'slide_' | append: i | append: '_subtext'
              assign slide_button_text_key = 'slide_' | append: i | append: '_button_text'
              assign slide_button_link_key = 'slide_' | append: i | append: '_button_link'

              assign slide_image = block.settings[slide_image_key]
              assign slide_heading = block.settings[slide_heading_key]
              assign slide_subtext = block.settings[slide_subtext_key]
              assign slide_button_text = block.settings[slide_button_text_key]
              assign slide_button_link = block.settings[slide_button_link_key]
            %}

            <div
              class="ai-two-column-slideshow__slide-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
              data-slide="{{ i }}"
            >
              <div class="ai-two-column-slideshow__slide-image-wrapper-{{ ai_gen_id }}">
                {% if slide_image %}
                  <img
                    src="{{ slide_image | image_url: width: 1200 }}"
                    alt="{{ slide_image.alt | escape }}"
                    class="ai-two-column-slideshow__slide-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ slide_image.width }}"
                    height="{{ slide_image.height }}"
                  >
                {% else %}
                  <div class="ai-two-column-slideshow__slide-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                <div class="ai-two-column-slideshow__slide-content-{{ ai_gen_id }}">
                  {% if slide_heading != blank %}
                    <h2 class="ai-two-column-slideshow__slide-heading-{{ ai_gen_id }}">
                      {{ slide_heading }}
                    </h2>
                  {% endif %}

                  {% if slide_subtext != blank %}
                    <p class="ai-two-column-slideshow__slide-subtext-{{ ai_gen_id }}">
                      {{ slide_subtext }}
                    </p>
                  {% endif %}

                  {% if slide_button_text != blank and slide_button_link != blank %}
                    <a
                      href="{{ slide_button_link }}"
                      class="ai-two-column-slideshow__slide-button-{{ ai_gen_id }}"
                    >
                      {{ slide_button_text }}
                    </a>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="ai-two-column-slideshow__dots-{{ ai_gen_id }}">
          {% for i in (1..3) %}
            <button
              class="ai-two-column-slideshow__dot-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
              data-slide="{{ i }}"
              aria-label="Go to slide {{ i }}"
            ></button>
          {% endfor %}
        </div>

        <div class="ai-two-column-slideshow__controls-{{ ai_gen_id }}">
          <button
            class="ai-two-column-slideshow__control-button-{{ ai_gen_id }} ai-two-column-slideshow__prev-{{ ai_gen_id }}"
            aria-label="Previous slide"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button
            class="ai-two-column-slideshow__control-button-{{ ai_gen_id }} ai-two-column-slideshow__next-{{ ai_gen_id }}"
            aria-label="Next slide"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div class="ai-two-column-slideshow__column-{{ ai_gen_id }}">
      <div class="ai-two-column-slideshow__fixed-image-{{ ai_gen_id }}">
        {% if block.settings.fixed_image_link != blank %}
          <a
            href="{{ block.settings.fixed_image_link }}"
            class="ai-two-column-slideshow__fixed-image-link-{{ ai_gen_id }}"
          >
        {% endif %}

        <div class="ai-two-column-slideshow__fixed-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.fixed_image %}
            <img
              src="{{ block.settings.fixed_image | image_url: width: 1200 }}"
              alt="{{ block.settings.fixed_image.alt | escape }}"
              class="ai-two-column-slideshow__fixed-img-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ block.settings.fixed_image.width }}"
              height="{{ block.settings.fixed_image.height }}"
            >
          {% else %}
            <div class="ai-two-column-slideshow__fixed-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        {% if block.settings.fixed_image_link != blank %}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</two-column-slideshow-{{ ai_gen_id }}>

<script>
  (function() {
    class TwoColumnSlideshow{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 1;
        this.totalSlides = 3;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.ai-two-column-slideshow__slide-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-two-column-slideshow__dot-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-two-column-slideshow__prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-two-column-slideshow__next-{{ ai_gen_id }}');

        this.setupEventListeners();
        this.startAutoplay();
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.goToPrevSlide());
        this.nextButton.addEventListener('click', () => this.goToNextSlide());

        this.dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            const slideNumber = parseInt(e.target.dataset.slide);
            this.goToSlide(slideNumber);
          });
        });
      }

      goToSlide(slideNumber) {
        this.slides.forEach((slide) => {
          slide.classList.remove('active');
        });

        this.dots.forEach((dot) => {
          dot.classList.remove('active');
        });

        const targetSlide = this.querySelector(
          `.ai-two-column-slideshow__slide-{{ ai_gen_id }}[data-slide="${slideNumber}"]`
        );
        const targetDot = this.querySelector(
          `.ai-two-column-slideshow__dot-{{ ai_gen_id }}[data-slide="${slideNumber}"]`
        );

        if (targetSlide) {
          targetSlide.classList.add('active');
        }

        if (targetDot) {
          targetDot.classList.add('active');
        }

        this.currentSlide = slideNumber;
        this.resetAutoplay();
      }

      goToNextSlide() {
        let nextSlide = this.currentSlide + 1;
        if (nextSlide > this.totalSlides) {
          nextSlide = 1;
        }
        this.goToSlide(nextSlide);
      }

      goToPrevSlide() {
        let prevSlide = this.currentSlide - 1;
        if (prevSlide < 1) {
          prevSlide = this.totalSlides;
        }
        this.goToSlide(prevSlide);
      }

      startAutoplay() {
        const autoplayEnabled = {{ block.settings.autoplay }};
        const autoplaySpeed = {{ block.settings.autoplay_speed }} * 1000;

        if (autoplayEnabled) {
          this.autoplayInterval = setInterval(() => {
            this.goToNextSlide();
          }, autoplaySpeed);
        }
      }

      resetAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('two-column-slideshow-{{ ai_gen_id }}', TwoColumnSlideshow{{ ai_gen_id }});
  })();
</script>

