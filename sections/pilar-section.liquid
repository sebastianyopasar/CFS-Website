{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap');

  .industrial-wrap {
    font-family: 'Montserrat', sans-serif;
    max-width: 1500px;
    margin: 100px auto;
    padding: 0 30px;
    color: #1a1a1a;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }

  .pillar-card {
    background: #ffffff;
    border-radius: 24px;
    padding: 60px 35px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: 0 10px 40px rgba(0,0,0,0.12);
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    border: 1px solid #f0f0f0;
  }

  .pillar-card:hover { transform: translateY(-20px); box-shadow: 0 20px 50px rgba(0,0,0,0.15); }

  .pillar-number {
    position: absolute;
    top: 30px;
    left: 30px;
    width: 75px;
    height: 75px;
    border: 4px solid #e0e6ed;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    color: #4a5568;
    font-size: 2rem;
  }

  .pillar-card h3 {
    font-weight: 900;
    font-size: 2.2rem; 
    line-height: 1.1;
    text-transform: uppercase;
    margin: 25px 0;
    min-height: 100px;
    color: #000;
  }

  .pillar-card .sub-brand {
    font-weight: 800;
    color: #333;
    margin-bottom: 15px;
    font-size: 1.6rem;
  }

  .pillar-card .brief-desc {
    font-size: 1.4rem;
    line-height: 1.6;
    color: #4a5568;
    margin-bottom: 30px;
  }

  .card-features label {
    font-weight: 900;
    font-size: 1.4rem;
    text-transform: uppercase;
    display: block;
    margin-bottom: 15px;
    color: #000;
  }

  .card-features ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 1.4rem;
    font-weight: 700;
  }

  .card-features li { margin-bottom: 12px; }

  .card-features li::before {
    content: "•";
    color: #0062cc;
    margin-right: 12px;
    font-weight: 900;
    font-size: 1.8rem;
  }

  /* BUTTON INTERACTION */
  .card-cta {
    background-color: #0062cc;
    color: white !important;
    padding: 25px 0;
    width: 100%;
    border-radius: 14px;
    font-weight: 900;
    text-decoration: none;
    font-size: 1.7rem;
    transition: all 0.2s ease-in-out;
    text-align: center;
    display: block;
    border: none;
    cursor: pointer;
  }

  .card-cta:hover { 
    background: #004a99; 
    transform: scale(1.03);
  }

  /* Visual "Bigger" Pop when clicked */
  .card-cta:active { 
    transform: scale(1.15);
    box-shadow: 0 0 30px rgba(0, 98, 204, 0.5);
  }

  /* --- MODAL OVERLAY (THIS WAS MISSING) --- */
  .overlay-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(255,255,255,0.99); /* Nearly solid white for premium look */
    z-index: 9999;
    display: none; /* Hidden by default */
    overflow-y: auto;
    padding: 50px 0;
  }

  .overlay-modal.active {
    display: block; /* Shown when JS triggers openPillar */
    animation: fadeIn 0.3s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .modal-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 70px;
    position: relative;
  }

  .modal-header {
    border-left: 25px solid #0062cc;
    padding-left: 45px;
    margin-bottom: 60px;
    display: flex;
    align-items: center;
  }

  .modal-num-tag {
    font-size: 7rem;
    font-weight: 900;
    color: #e2e8f0;
    margin-right: 35px;
    line-height: 1;
  }

  .modal-header h2 {
    font-weight: 900;
    font-size: 5rem;
    line-height: 1;
    margin: 0;
    text-transform: uppercase;
  }

  .modal-inner p {
    font-size: 2rem;
    line-height: 1.8;
    font-weight: 500;
    color: #333;
    margin-bottom: 40px;
  }

  .feat-list-expanded div {
    font-size: 1.8rem;
    margin-bottom: 30px;
    line-height: 1.5;
  }

  .feat-list-expanded strong { font-weight: 900; color: #000; }

  .close-btn {
    position: absolute;
    top: -20px;
    right: 40px;
    cursor: pointer;
    text-align: center;
    z-index: 10000;
  }

  .close-btn span { font-size: 6rem; line-height: 1; display: block; }
  .close-btn label { font-size: 1.3rem; font-weight: 900; text-transform: uppercase; display: block; }

  @media (max-width: 1024px) {
    .pillars-grid { grid-template-columns: repeat(2, 1fr); }
    .modal-header h2 { font-size: 3.5rem; }
  }
  @media (max-width: 600px) {
    .pillars-grid { grid-template-columns: 1fr; }
    .modal-header h2 { font-size: 2.5rem; }
    .modal-num-tag { font-size: 4.5rem; }
    .pillar-card h3 { font-size: 1.8rem; }
    .modal-inner p { font-size: 1.5rem; }
  }
{%- endstyle -%}

