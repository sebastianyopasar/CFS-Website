{% doc %}
  @prompt
    Design a modern, premium website section for a commercial cleaning and facility supply company focused on flood recovery solutions. The layout should be clean, spacious, and highly professional, using a minimalist design with excellent visual hierarchy, subtle shadows, rounded corners, and generous white space.
    
    At the top of the section, create a full-width introduction area with enough room for:
    
    A large headline (H2)
    A short supporting paragraph below the headline (2–3 sentences)
    
    This introductory area is intended to explain how professional products help facilities recover after flooding by eliminating odors, preventing mold, and disinfecting affected surfaces.
    
    Below the introduction, create two independent horizontal feature cards, separated by generous vertical spacing so they feel like two distinct product recommendations rather than one continuous layout.
    
    First Product Card
    
    A large product image area positioned on the left side.
    The image should appear inside a clean product container with subtle elevation and enough space for a clickable product image.
    Leave enough room around the product so it becomes the visual focus.
    On the right side, create a large content area with:
    Space for a bold product title
    Space for a short descriptive paragraph
    Optional area for a "Learn More" or "Shop Now" button beneath the text
    
    Second Product Card
    
    Reverse the layout for visual balance.
    
    The text block should appear on the left.
    The product image should appear on the right inside the same style product container.
    Again provide room for:
    Large product title
    Description
    Optional CTA button
    
    Leave a comfortable amount of empty space between the text block and the product image so it is immediately obvious which content belongs to which product.
    
    The overall design should feel elegant, modern, and easy to scan, using a subtle visual rhythm created by the alternating layouts.
    
    The section should be optimized for desktop websites, approximately 1400–1600 pixels wide, with responsive proportions that can easily adapt to tablet and mobile layouts.
    
    Use a clean white or very light gray background with subtle accents inspired by water and cleanliness. Avoid excessive gradients, busy graphics, unnecessary decorations, or oversized icons. The design should communicate trust, professionalism, and commercial facility maintenance.
    
    Style references: Apple website, Stripe, Linear, Webflow Enterprise, modern SaaS landing pages, premium B2B corporate websites.
    
    Important: Use realistic placeholder blocks for the products and text only. Do not include actual product images, logos, brand names, or written copy. The layout should serve as a high-end wireframe/mockup showcasing spacing, alignment, typography hierarchy, clickable product image areas, and call-to-action placement. The result should look polished enough to be handed directly to a UI developer.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-flood-recovery-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-flood-recovery-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.container_padding_horizontal }}px;
  }

  .ai-flood-recovery-intro-{{ ai_gen_id }} {
    text-align: {{ block.settings.intro_text_alignment }};
    margin-bottom: {{ block.settings.intro_bottom_spacing }}px;
    max-width: {{ block.settings.intro_max_width }}px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-flood-recovery-resource-button-{{ ai_gen_id }} {
  display: flex;
  justify-content: {{ block.settings.resource_button_alignment }};
  margin: 0 0 {{ block.settings.resource_button_bottom_spacing }}px;
}

.ai-flood-recovery-resource-link-{{ ai_gen_id }} {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: {{ block.settings.resource_button_padding_vertical }}px {{ block.settings.resource_button_padding_horizontal }}px;
  background: {{ block.settings.resource_button_background }};
  color: {{ block.settings.resource_button_text_color }};
  border: 1px solid {{ block.settings.resource_button_border_color }};
  border-radius: {{ block.settings.resource_button_radius }}px;
  text-decoration: none;
  font-size: {{ block.settings.resource_button_font_size }}px;
  font-weight: 600;
  transition: all .25s ease;
}

.ai-flood-recovery-resource-link-{{ ai_gen_id }}:hover {
  background: {{ block.settings.resource_button_hover_background }};
  color: {{ block.settings.resource_button_hover_text_color }};
  border-color: {{ block.settings.resource_button_hover_border_color }};
  transform: translateY(-2px);
}

.ai-flood-recovery-resource-link-{{ ai_gen_id }} svg {
  width:18px;
  height:18px;
}
  .ai-flood-recovery-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_bottom_spacing }}px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .ai-flood-recovery-intro-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.intro_text_size }}px;
    line-height: 1.6;
    color: {{ block.settings.intro_text_color }};
    margin: 0;
    opacity: 0.85;
  }

  .ai-flood-recovery-card-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.card_content_gap }}px;
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
    margin-bottom: {{ block.settings.card_spacing }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-flood-recovery-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical | plus: 8 }}px {{ block.settings.card_shadow_blur | plus: 10 }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | times: 1.5 | divided_by: 100.0 | at_most: 0.2 }});
  }

  .ai-flood-recovery-card-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-flood-recovery-card-reverse-{{ ai_gen_id }} {
    flex-direction: row-reverse;
  }

  .ai-flood-recovery-product-container-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.product_image_width }}%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.product_container_bg }};
    border-radius: {{ block.settings.product_container_radius }}px;
    padding: {{ block.settings.product_container_padding }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .ai-flood-recovery-product-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    cursor: pointer;
  }

  .ai-flood-recovery-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.product_image_radius }}px;
    transition: transform 0.3s ease;
  }

  .ai-flood-recovery-product-image-wrapper-{{ ai_gen_id }}:hover .ai-flood-recovery-product-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-flood-recovery-product-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f8f9fa;
    border-radius: {{ block.settings.product_image_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .ai-flood-recovery-product-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-flood-recovery-content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-flood-recovery-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    font-weight: {{ block.settings.product_title_weight }};
    color: {{ block.settings.product_title_color }};
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .ai-flood-recovery-product-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_description_size }}px;
    line-height: 1.6;
    color: {{ block.settings.product_description_color }};
    margin: 0;
    opacity: 0.8;
  }

  .ai-flood-recovery-cta-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
    align-self: flex-start;
  }

  .ai-flood-recovery-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateX(4px);
  }

  .ai-flood-recovery-cta-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
  }

  .ai-flood-recovery-cta-{{ ai_gen_id }}:hover .ai-flood-recovery-cta-icon-{{ ai_gen_id }} {
    transform: translateX(4px);
  }

  @media screen and (max-width: 989px) {
    .ai-flood-recovery-card-{{ ai_gen_id }},
    .ai-flood-recovery-card-reverse-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.card_content_gap | times: 0.75 }}px;
    }

    .ai-flood-recovery-product-container-{{ ai_gen_id }} {
      flex: 0 0 auto;
      width: 100%;
      max-width: 400px;
    }

    .ai-flood-recovery-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-flood-recovery-intro-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.intro_text_size | times: 0.9 }}px;
    }

    .ai-flood-recovery-product-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.product_title_size | times: 0.85 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-flood-recovery-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 0 {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-flood-recovery-container-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.container_padding_horizontal | times: 0.5 }}px;
    }

    .ai-flood-recovery-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.6 }}px;
    }

    .ai-flood-recovery-intro-{{ ai_gen_id }} {
      margin-bottom: {{ block.settings.intro_bottom_spacing | times: 0.7 }}px;
    }
  }
{% endstyle %}

<flood-recovery-section-{{ ai_gen_id }} class="ai-flood-recovery-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-flood-recovery-container-{{ ai_gen_id }}">
    {% if block.settings.show_intro %}
      <div class="ai-flood-recovery-intro-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-flood-recovery-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.intro_text != blank %}
          <div class="ai-flood-recovery-intro-text-{{ ai_gen_id }}">{{ block.settings.intro_text }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.show_product_1 %}
      <div class="ai-flood-recovery-card-{{ ai_gen_id }}">
        <div class="ai-flood-recovery-product-container-{{ ai_gen_id }}">
          {% if block.settings.product_1 != blank %}
            <a href="{{ block.settings.product_1.url }}" class="ai-flood-recovery-product-image-wrapper-{{ ai_gen_id }}">
              {% if block.settings.product_1.featured_image %}
                <img
                  src="{{ block.settings.product_1.featured_image | image_url: width: 800 }}"
                  alt="{{ block.settings.product_1.featured_image.alt | escape }}"
                  class="ai-flood-recovery-product-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {% else %}
                <div class="ai-flood-recovery-product-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </a>
          {% else %}
            <div class="ai-flood-recovery-product-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        <div class="ai-flood-recovery-content-{{ ai_gen_id }}">
          {% if block.settings.product_1_title != blank %}
            <h3 class="ai-flood-recovery-product-title-{{ ai_gen_id }}">{{ block.settings.product_1_title }}</h3>
          {% elsif block.settings.product_1 != blank %}
            <h3 class="ai-flood-recovery-product-title-{{ ai_gen_id }}">{{ block.settings.product_1.title }}</h3>
          {% endif %}

          {% if block.settings.product_1_description != blank %}
            <div class="ai-flood-recovery-product-description-{{ ai_gen_id }}">{{ block.settings.product_1_description }}</div>
          {% endif %}

          {% if block.settings.show_product_1_cta %}
            {% if block.settings.product_1 != blank %}
              <a href="{{ block.settings.product_1.url }}" class="ai-flood-recovery-cta-{{ ai_gen_id }}">
                {{ block.settings.product_1_cta_text }}
                <svg class="ai-flood-recovery-cta-icon-{{ ai_gen_id }}" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {% elsif block.settings.product_1_cta_url != blank %}
              <a href="{{ block.settings.product_1_cta_url }}" class="ai-flood-recovery-cta-{{ ai_gen_id }}">
                {{ block.settings.product_1_cta_text }}
                <svg class="ai-flood-recovery-cta-icon-{{ ai_gen_id }}" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {% endif %}
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_product_2 %}
      <div class="ai-flood-recovery-card-{{ ai_gen_id }} ai-flood-recovery-card-reverse-{{ ai_gen_id }}">
        <div class="ai-flood-recovery-product-container-{{ ai_gen_id }}">
          {% if block.settings.product_2 != blank %}
            <a href="{{ block.settings.product_2.url }}" class="ai-flood-recovery-product-image-wrapper-{{ ai_gen_id }}">
              {% if block.settings.product_2.featured_image %}
                <img
                  src="{{ block.settings.product_2.featured_image | image_url: width: 800 }}"
                  alt="{{ block.settings.product_2.featured_image.alt | escape }}"
                  class="ai-flood-recovery-product-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {% else %}
                <div class="ai-flood-recovery-product-placeholder-{{ ai_gen_id }}">
                  {{ 'product-2' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </a>
          {% else %}
            <div class="ai-flood-recovery-product-placeholder-{{ ai_gen_id }}">
              {{ 'product-2' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        <div class="ai-flood-recovery-content-{{ ai_gen_id }}">
          {% if block.settings.product_2_title != blank %}
            <h3 class="ai-flood-recovery-product-title-{{ ai_gen_id }}">{{ block.settings.product_2_title }}</h3>
          {% elsif block.settings.product_2 != blank %}
            <h3 class="ai-flood-recovery-product-title-{{ ai_gen_id }}">{{ block.settings.product_2.title }}</h3>
          {% endif %}

          {% if block.settings.product_2_description != blank %}
            <div class="ai-flood-recovery-product-description-{{ ai_gen_id }}">{{ block.settings.product_2_description }}</div>
          {% endif %}

          {% if block.settings.show_product_2_cta %}
            {% if block.settings.product_2 != blank %}
              <a href="{{ block.settings.product_2.url }}" class="ai-flood-recovery-cta-{{ ai_gen_id }}">
                {{ block.settings.product_2_cta_text }}
                <svg class="ai-flood-recovery-cta-icon-{{ ai_gen_id }}" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {% elsif block.settings.product_2_cta_url != blank %}
              <a href="{{ block.settings.product_2_cta_url }}" class="ai-flood-recovery-cta-{{ ai_gen_id }}">
                {{ block.settings.product_2_cta_text }}
                <svg class="ai-flood-recovery-cta-icon-{{ ai_gen_id }}" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {% endif %}
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</flood-recovery-section-{{ ai_gen_id }}>

<script>
  (function() {
    class FloodRecoverySection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const cards = this.querySelectorAll('.ai-flood-recovery-card-{{ ai_gen_id }}');
        cards.forEach((card, index) => {
          card.setAttribute('role', 'article');
          card.setAttribute('aria-label', `Product recommendation ${index + 1}`);
        });
      }
    }

    customElements.define('flood-recovery-section-{{ ai_gen_id }}', FloodRecoverySection{{ ai_gen_id }});
  })();
</script>

