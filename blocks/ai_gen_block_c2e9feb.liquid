<script>
  (function() {
    class KnowledgeBase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initializeAccessibility();
      }

      initializeAccessibility() {
        const links = this.querySelectorAll('.ai-knowledge-base-link-{{ ai_gen_id }}, .ai-knowledge-base-button-{{ ai_gen_id }}');
        links.forEach(link => {
          if (link.getAttribute('href') === '' || link.getAttribute('href') === null) {
            link.setAttribute('aria-disabled', 'true');
            link.style.pointerEvents = 'none';
            link.style.opacity = '0.5';
          }
        });
      }
    }

    customElements.define('knowledge-base-{{ ai_gen_id }}', KnowledgeBase{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Knowledge base portal",
  "settings": [
    {
      "type": "header",
      "content": "Main header"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show header",
      "default": true
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Title",
      "default": "Corporate Knowledge Base & Resource Portal"
    },
    {
      "type": "text",
      "id": "main_subtitle",
      "label": "Subtitle",
      "default": "Technical documentation, training resources, and operational guides for facility management professionals"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_spacing",
      "label": "Section spacing",
      "min": 20,
      "max": 80,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Equipment & machinery hub"
    },
    {
      "type": "checkbox",
      "id": "show_equipment_hub",
      "label": "Show equipment hub",
      "default": true
    },
    {
      "type": "text",
      "id": "equipment_title",
      "label": "Title",
      "default": "Commercial Equipment & Machinery Hub"
    },
