{% doc %}
  @prompt
    I want a small section with three main items and icons which tell this information: Free Shipping within
    Niagara Region
    Returns and Exchanges
    24/7 Customer Support
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-features-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-features-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.gap }}px;
  }

  .ai-features-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: {{ block.settings.item_gap }}px;
  }

  .ai-features-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
  }

  .ai-features-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-features-text-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-features-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-features-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .ai-features-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.gap | times: 1.5 }}px;
    }

    .ai-features-item-{{ ai_gen_id }} {
      flex-direction: row;
      text-align: left;
      gap: {{ block.settings.item_gap | times: 1.2 }}px;
    }

    .ai-features-icon-{{ ai_gen_id }} {
      flex-shrink: 0;
    }
  }
{% endstyle %}

<div class="ai-features-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-features-container-{{ ai_gen_id }}">
    <div class="ai-features-item-{{ ai_gen_id }}">
      <div class="ai-features-icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="3" width="15" height="13"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
      </div>
      <div class="ai-features-text-{{ ai_gen_id }}">
        <h3 class="ai-features-title-{{ ai_gen_id }}">{{ block.settings.feature_1_title }}</h3>
        {% if block.settings.feature_1_description != blank %}
          <p class="ai-features-description-{{ ai_gen_id }}">{{ block.settings.feature_1_description }}</p>
        {% endif %}
      </div>
    </div>

    <div class="ai-features-item-{{ ai_gen_id }}">
      <div class="ai-features-icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 11 12 14 22 4"></polyline>
          <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
        </svg>
      </div>
      <div class="ai-features-text-{{ ai_gen_id }}">
        <h3 class="ai-features-title-{{ ai_gen_id }}">{{ block.settings.feature_2_title }}</h3>
        {% if block.settings.feature_2_description != blank %}
          <p class="ai-features-description-{{ ai_gen_id }}">{{ block.settings.feature_2_description }}</p>
        {% endif %}
      </div>
    </div>

    <div class="ai-features-item-{{ ai_gen_id }}">
      <div class="ai-features-icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
      </div>
      <div class="ai-features-text-{{ ai_gen_id }}">
        <h3 class="ai-features-title-{{ ai_gen_id }}">{{ block.settings.feature_3_title }}</h3>
        {% if block.settings.feature_3_description != blank %}
          <p class="ai-features-description-{{ ai_gen_id }}">{{ block.settings.feature_3_description }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Features bar",
  "settings": [
    {
      "type": "header",
      "content": "Feature 1"
    },
    {
      "type": "text",
      "id": "feature_1_title",
      "label": "Title",
      "default": "Free Shipping"
    },
    {
      "type": "text",
      "id": "feature_1_description",
      "label": "Description",
      "default": "Within Niagara Region"
    },
    {
      "type": "header",
      "content": "Feature 2"
    },
    {
      "type": "text",
      "id": "feature_2_title",
      "label": "Title",
      "default": "Returns and Exchanges"
    },
    {
      "type": "text",
      "id": "feature_2_description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Feature 3"
    },
    {
      "type": "text",
      "id": "feature_3_title",
      "label": "Title",
      "default": "24/7 Customer Support"
    },
    {
      "type": "text",
      "id": "feature_3_description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0e1b4d"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#0e1b4d"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 24,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Icon size",
      "default": 40
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 16
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 600,
      "max": 1400,
      "step": 100,
      "unit": "px",
      "label": "Container width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "gap",
      "min": 16,
      "max": 80,
      "step": 8,
      "unit": "px",
      "label": "Space between items",
      "default": 40
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "label": "Space between icon and text",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Features bar"
    }
  ]
}
{% endschema %}
