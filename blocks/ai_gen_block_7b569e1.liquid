{% doc %}
  @prompt
    I want two columns. The first one is a two vertical square and vertical setting that allows me to add images, have text when I hover and have proper links when click, the other 2/3 is a slideshow with links to jump into particular sections of the website. I want it so i can customize the size for every image and height and width of the section, also I just want 3 images in the slideshow with links, I would like to also be able to set the width of this section. Please also help me adding the border radius on the right column, When I have different screen formats this height and width changes. Please make this fixed for a full width and a desktop version, but also for the cellphone version make the format different. Make the left column in vertical and the slideshow below it, Center it please
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-layout-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-two-column-container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.column_gap }}px;
    width: 100%;
  }

  .ai-left-column-{{ ai_gen_id }} {
    flex: 0 0 33.333%;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.left_column_gap }}px;
  }

  .ai-image-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.left_border_radius }}px;
    width: 100%;
    height: {{ block.settings.left_image_height }}px;
  }

  .ai-image-card-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .ai-image-card-img-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-image-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-card-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-card-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .ai-image-card-link-{{ ai_gen_id }}:hover .ai-image-card-overlay-{{ ai_gen_id }} {
    opacity: {{ block.settings.overlay_opacity }};
  }

  .ai-image-card-text-{{ ai_gen_id }} {
    color: {{ block.settings.overlay_text_color }};
    font-size: {{ block.settings.overlay_text_size }}px;
    text-align: center;
    font-weight: 600;
  }

  .ai-right-column-{{ ai_gen_id }} {
    flex: 0 0 66.666%;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.right_border_radius }}px;
    height: {{ block.settings.right_column_height }}px;
  }

  .ai-slideshow-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-slideshow-slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .ai-slideshow-slide-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-slideshow-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ai-slideshow-img-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-slideshow-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-slideshow-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-slideshow-dots-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 10;
  }

  .ai-slideshow-dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.5;
    cursor: pointer;
    border: none;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-slideshow-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-two-column-container-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-left-column-{{ ai_gen_id }} {
      flex: 0 0 auto;
      width: 100%;
    }

    .ai-right-column-{{ ai_gen_id }} {
      flex: 0 0 auto;
      width: 100%;
      height: {{ block.settings.mobile_slideshow_height }}px;
    }

    .ai-image-card-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_left_image_height }}px;
    }
  }
{% endstyle %}

<two-column-slideshow-{{ ai_gen_id }}
  class="ai-two-column-layout-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-two-column-container-{{ ai_gen_id }}">
    <div class="ai-left-column-{{ ai_gen_id }}">
      {% for i in (1..2) %}
        {% liquid
          assign image_key = 'left_image_' | append: i
          assign text_key = 'left_text_' | append: i
          assign link_key = 'left_link_' | append: i
          assign image = block.settings[image_key]
          assign text = block.settings[text_key]
          assign link = block.settings[link_key]
        %}

        <div class="ai-image-card-{{ ai_gen_id }}">
          {% if link != blank %}
            <a href="{{ link }}" class="ai-image-card-link-{{ ai_gen_id }}">
          {% else %}
            <div class="ai-image-card-link-{{ ai_gen_id }}">
          {% endif %}
            {% if image %}
              <img
                src="{{ image | image_url: width: 800 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
                class="ai-image-card-img-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-image-card-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
            {% if text != blank %}
              <div class="ai-image-card-overlay-{{ ai_gen_id }}">
                <div class="ai-image-card-text-{{ ai_gen_id }}">{{ text }}</div>
              </div>
            {% endif %}
          {% if link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="ai-right-column-{{ ai_gen_id }}">
      <div class="ai-slideshow-container-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          {% liquid
            assign slide_image_key = 'slide_image_' | append: i
            assign slide_link_key = 'slide_link_' | append: i
            assign slide_image = block.settings[slide_image_key]
            assign slide_link = block.settings[slide_link_key]
          %}

          <div
            class="ai-slideshow-slide-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
            data-slide-index="{{ i }}"
          >
            {% if slide_link != blank %}
              <a href="{{ slide_link }}" class="ai-slideshow-link-{{ ai_gen_id }}">
            {% else %}
              <div class="ai-slideshow-link-{{ ai_gen_id }}">
            {% endif %}
              {% if slide_image %}
                <img
                  src="{{ slide_image | image_url: width: 2000 }}"
                  alt="{{ slide_image.alt | escape }}"
                  {% if i == 1 %}
                    loading="eager"
                    fetchpriority="high"
                  {% else %}
                    loading="lazy"
                  {% endif %}
                  width="{{ slide_image.width }}"
                  height="{{ slide_image.height }}"
                  class="ai-slideshow-img-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-slideshow-placeholder-{{ ai_gen_id }}">
                  {{ 'hero-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            {% if slide_link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </div>
        {% endfor %}

        <div class="ai-slideshow-dots-{{ ai_gen_id }}">
          {% for i in (1..3) %}
            <button
              class="ai-slideshow-dot-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
              data-dot-index="{{ i }}"
              aria-label="Go to slide {{ i }}"
            ></button>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</two-column-slideshow-{{ ai_gen_id }}>

<script>
  (function() {
    class TwoColumnSlideshow{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 1;
        this.totalSlides = 3;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.ai-slideshow-slide-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-slideshow-dot-{{ ai_gen_id }}');
        this.setupEventListeners();
        this.startAutoplay();
      }

      setupEventListeners() {
        this.dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            const index = parseInt(dot.getAttribute('data-dot-index'));
            this.goToSlide(index);
            this.resetAutoplay();
          });
        });
      }

      goToSlide(index) {
        this.slides.forEach((slide) => {
          slide.classList.remove('active');
        });
        this.dots.forEach((dot) => {
          dot.classList.remove('active');
        });

        const targetSlide = this.querySelector(`[data-slide-index="${index}"]`);
        const targetDot = this.querySelector(`[data-dot-index="${index}"]`);

        if (targetSlide) {
          targetSlide.classList.add('active');
        }
        if (targetDot) {
          targetDot.classList.add('active');
        }

        this.currentSlide = index;
      }

      nextSlide() {
        let next = this.currentSlide + 1;
        if (next > this.totalSlides) {
          next = 1;
        }
        this.goToSlide(next);
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, {{ block.settings.autoplay_speed | times: 1000 }});
      }

      resetAutoplay() {
        clearInterval(this.autoplayInterval);
        this.startAutoplay();
      }

      disconnectedCallback() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('two-column-slideshow-{{ ai_gen_id }}', TwoColumnSlideshow{{ ai_gen_id }});
  })();
</script>

